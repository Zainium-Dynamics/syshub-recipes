[Unit]
Description=Load AppArmor profiles
Documentation=man:apparmor(7)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target
ConditionSecurity=apparmor

[Service]
Type=oneshot
RemainAfterExit=yes
# Every profile in apparmor.d in one parser run, compiled into the cache on the first boot and
# loaded from it afterwards. A profile the kernel cannot take is reported and the rest still
# load; the parser exits non-zero for any warning, hence the "-". `aa-status` shows the result.
ExecStart=-/overlayer/syshub/bin/apparmor_parser --replace --quiet --jobs=auto --max-jobs=4 --write-cache --cache-loc=/overlayer/syshub/var/cache/apparmor --base=/overlayer/syshub/etc/apparmor.d --Include=/overlayer/syshub/etc/apparmor.d /overlayer/syshub/etc/apparmor.d
ExecReload=/overlayer/syshub/bin/systemctl restart apparmor.service

[Install]
WantedBy=sysinit.target
