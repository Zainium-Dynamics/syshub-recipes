maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=avahi
pkgver=0.8
pkgrel=1
subpackages="avahi-dev"
source="https://github.com/avahi/avahi/releases/download/v$pkgver/avahi-$pkgver.tar.gz"
sha256sums="060309d7a333d38d951bc27598c677af1796934dbd98e1024e7ad8de798fedda  avahi-$pkgver.tar.gz"
needs_toolchain="libdaemon libdaemon-dev dbus dbus-dev expat expat-dev systemd glib glib-dev pcre2 pcre2-dev libffi libffi-dev"
makedepends="pkgconf intltool gettext"

# mDNS/DNS-SD stack: avahi-daemon + libavahi-common/core/client, which CUPS uses
# to discover driverless (IPP Everywhere) printers. All language/GUI bindings off.
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    # dbus-1.pc pulls libsystemd (no .pc shipped), so pkg-config for dbus fails;
    # feed the flags directly as configure suggests, bypassing pkg-config.
    export DBUS_CFLAGS="-I/overlayer/syshub/include/dbus-1.0 -I/overlayer/syshub/lib/dbus-1.0/include"
    export DBUS_LIBS="-L/overlayer/syshub/lib -ldbus-1"
    # avahi 0.8 still calls dbus_connection_disconnect(), removed from dbus
    # long ago (now dbus_connection_close); GCC 15 makes the implicit decl a
    # hard error. Map the old name to the current one at preprocess time.
    export CFLAGS="${CFLAGS:-} -Ddbus_connection_disconnect=dbus_connection_close"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --sbindir=/overlayer/syshub/bin \
        --disable-static \
        --disable-nls \
        --disable-mono --disable-monodoc \
        --disable-qt3 --disable-qt4 --disable-qt5 \
        --disable-gtk --disable-gtk3 \
        --disable-python --disable-pygobject \
        --enable-glib --disable-gobject \
        --disable-libevent \
        --disable-manpages --disable-xmltoman \
        --disable-gdbm --disable-dbm \
        --enable-dbus \
        --with-xml=expat \
        --with-distro=none \
        --with-systemdsystemunitdir=no
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/etc" "$PAYLOAD_DIR/share"
    find "$inst/lib" -maxdepth 1 -name 'libavahi-*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/etc/." "$PAYLOAD_DIR/etc/" 2>/dev/null || true
    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
    # avahi-autoipd.action etc. hardcode /usr paths; layout policy forbids any
    # /usr reference in payload content, so rewrite them to Zainium paths.
    for f in $(grep -rIl "/usr/" "$PAYLOAD_DIR" 2>/dev/null); do
        sed -i -e "s#/usr/sbin#/overlayer/syshub/bin#g" \
               -e "s#/usr/bin#/overlayer/syshub/bin#g" \
               -e "s#/usr/share#/overlayer/syshub/share#g" \
               -e "s#/usr/#/overlayer/syshub/#g" "$f"
    done
    rm -rf "$PAYLOAD_DIR/share/man" "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/locale"
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
