maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=systemd
pkgver=261.2
pkgrel=0
subpackages="$pkgname-dev"
source="https://github.com/systemd/systemd/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="ed1059ff964f5df35b6056434cc17cc83f86dc913f10489948a0b19b6081c5ec  v$pkgver.tar.gz"
makedepends="meson ninja pkgconf gperf python3 py3-jinja2 build-base linux-headers gettext-dev libucontext-dev coreutils
    libcap-dev libseccomp-dev kmod-dev pcre2-dev
    xz-dev zstd-dev zlib-dev
    elfutils-dev libarchive-dev libxkbcommon-dev
    curl-dev openssl-dev libapparmor-dev"

# util-linux is our own syshub package, not Alpine's -- pulled in as a
# real dependency (not apk) so meson picks up its libmount.pc/headers
# under /overlayer/syshub, giving a real "libmount: YES" instead of
# Alpine's musl-but-not-Zainium-runtime libmount.so.
needs_toolchain="util-linux"

build() {
    grep -rl '"/bin/sh"' src/ | xargs -r sed -i 's#"/bin/sh"#"/overlayer/syshub/bin/bash"#g'

    # --sysconfdir=/overlayer/syshub/etc (set below) only affects paths
    # meson actually parameterizes. A handful of real files/*.c ship a
    # bare `secure_getenv("SYSTEMD_X") ?: "/etc/whatever"` fallback
    # instead -- a literal C string compiled straight into the binary,
    # never touched by --sysconfdir. Confirmed root cause of the
    # `localhost login:` hostname bug (hostname-util.c's etc_hostname()):
    # Zainium has no real /etc, so hostname_setup()'s open() of the
    # literal "/etc/hostname" always misses, silently falling back to
    # "localhost" -- despite /overlayer/syshub/etc/hostname existing
    # and being correct. Same exact pattern (grepped across src/basic
    # and src/shared) hits machine-info/localtime/fstab/locale.conf/
    # vconsole.conf too -- fixed here in one pass, not one bug report
    # at a time as each gets hit at boot.
    sed -i 's#"/etc/hostname"#"/overlayer/syshub/etc/hostname"#' src/basic/hostname-util.c
    sed -i 's#"/etc/machine-info"#"/overlayer/syshub/etc/machine-info"#' src/basic/hostname-util.c
    sed -i 's#"/etc/localtime"#"/overlayer/syshub/etc/localtime"#' src/basic/time-util.c
    sed -i 's#"/etc/fstab"#"/overlayer/syshub/etc/fstab"#' src/shared/fstab-util.c
    sed -i 's#"/etc/locale.conf"#"/overlayer/syshub/etc/locale.conf"#' src/shared/locale-setup.c
    sed -i 's#"/etc/vconsole.conf"#"/overlayer/syshub/etc/vconsole.conf"#' src/shared/locale-setup.c

    export LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

    meson setup builddir \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --libdir=/overlayer/syshub/lib \
        -Ddbuspolicydir=/overlayer/syshub/etc/dbus-1/system.d \
        -Ddbussessionservicedir=/overlayer/syshub/share/dbus-1/services \
        -Ddbussystemservicedir=/overlayer/syshub/share/dbus-1/system-services \
        -Dpamlibdir=/overlayer/syshub/lib/security \
        -Dmode=release \
        -Dlibc=musl \
        -Dsplit-bin=false \
        -Dtests=false \
        -Dman=disabled \
        -Dhtml=disabled \
        -Dbootloader=disabled \
        -Defi=false \
        -Dukify=disabled \
        -Dbpf-framework=disabled \
        -Dselinux=disabled \
        -Dapparmor=enabled \
        -Dsmack=false \
        -Dima=false \
        -Dipe=false \
        -Dpolkit=disabled \
        -Daudit=disabled \
        -Dxenctrl=disabled \
        -Dacl=disabled \
        -Dpam=disabled \
        -Dlibcryptsetup=disabled \
        -Dlibcryptsetup-plugins=disabled \
        -Dtpm2=disabled \
        -Dlibfido2=disabled \
        -Dgnutls=disabled \
        -Dp11kit=disabled \
        -Dqrencode=disabled \
        -Dmicrohttpd=disabled \
        -Dpwquality=disabled \
        -Dpasswdqc=disabled \
        -Dlibidn2=disabled \
        -Didn=false \
        -Dbzip2=disabled \
        -Dlz4=disabled \
        -Ddbus-interfaces-dir=no \
        -Ddebug-shell=/overlayer/syshub/bin/bash \
        -Ddefault-user-shell=/overlayer/syshub/bin/bash \
        -Duser-path=/overlayer/syshub/bin \
        -Dcertificate-root=/overlayer/syshub/etc/ssl \
        -Dnologin-path=/overlayer/syshub/bin/nologin \
        -Dsulogin-path=/overlayer/syshub/bin/sulogin \
        -Dagetty-path=/overlayer/syshub/bin/agetty \
        -Dmount-path=/overlayer/syshub/bin/mount \
        -Dumount-path=/overlayer/syshub/bin/umount \
        -Dswapon-path=/overlayer/syshub/bin/swapon \
        -Dswapoff-path=/overlayer/syshub/bin/swapoff \
        -Dloadkeys-path=/overlayer/syshub/bin/loadkeys \
        -Dsetfont-path=/overlayer/syshub/bin/setfont \
        -Dquotaon-path=/overlayer/syshub/bin/quotaon \
        -Dquotacheck-path=/overlayer/syshub/bin/quotacheck \
        -Dkmod-path=/overlayer/syshub/bin/kmod \
        -Dkexec-path=/overlayer/syshub/bin/kexec
    ninja -C builddir
}

package() {
    DESTDIR="$PAYLOAD_DIR" ninja -C builddir install

    mkdir -p "$STAGING_ROOT/_systemd-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_systemd-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_systemd-dev/pkgconfig"

    # `sed -i` rewrites files in place at the byte level -- fine for text,
    # catastrophic for ELF: replacing "/usr/lib/" (9 bytes) with
    # "/overlayer/syshub/lib/" (22 bytes) shifts every byte after the match,
    # which corrupts every fixed offset the ELF format depends on (section
    # header table, string table sizes, .dynamic). `grep -I` is supposed to
    # skip binaries but isn't reliable enough here to trust alone, so filter
    # explicitly with `file` too -- only ever touch confirmed text files.
    is_text_file() {
        case "$(file -b --mime-type "$1")" in
            text/*) return 0 ;;
            *) return 1 ;;
        esac
    }

    for f in $(grep -rIl "/usr/" "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i \
            -e 's#/usr/lib/#/overlayer/syshub/lib/#g' \
            -e 's#/usr/sbin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/bin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/share/#/overlayer/syshub/share/#g' \
            -e 's#/usr/#/overlayer/syshub/#g' \
            "$f"
    done

    # tmpfiles.d/*.conf and friends ship with literal /var/... runtime
    # paths -- --localstatedir only affects compiled-in constants, not
    # these shipped data files. Zainium has no real top-level /var (only
    # /overlayer/syshub/var), so leaving them as-is would make
    # systemd-tmpfiles create/reference the wrong location at boot.
    for f in $(grep -rIl '/var/' "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i 's#/var/#/overlayer/syshub/var/#g' "$f"
    done

    # Same bug class again, third time: systemd-logind/-localed/
    # -hostnamed/-timedated.service.in ship a literal, un-templated
    # `ReadWritePaths=/etc ...` (confirmed by reading the actual --
    # meson's --sysconfdir doesn't touch this line at all, it's a bare
    # C-string-equivalent in the .service.in, same as the hardcoded
    # "/etc/hostname" etc. C literals fixed via source sed above).
    # ProtectSystem=strict + a ReadWritePaths that resolves nowhere on
    # Zainium (no real /etc) meant these 4 units silently couldn't
    # write their runtime state -- root-caused this by diff against a
    # real host Fedora's own deployed unit, 2026-09-03. Confirmed via a
    # full sweep of every enabled unit (multi-user/sysinit/basic/
    # getty.target.wants) that no other unit has this same bug. Note
    # the trailing-slash convention the /usr/ and /var/ loops above use
    # doesn't apply here -- `ReadWritePaths=/etc /run` has no slash
    # after "etc", so match "/etc" itself when followed by whitespace,
    # a comma, or end-of-line, not "/etc/" with a slash.
    for f in $(grep -rIl '/etc' "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        # Grep above is deliberately loose (portable across GNU/BusyBox
        # grep); the sed itself is the real filter -- only rewrites a
        # genuine standalone "/etc" (space/comma/end-of-line after it),
        # so a real "/etc/passwd"-shaped path or an unrelated word like
        # "/etcetera" is left alone either way.
        sed -i -E 's#/etc([[:space:],]|$)#/overlayer/syshub/etc\1#g' "$f"
    done

    # Same bug class once more, but "/etc/something" (slash + content) --
    # NOT covered by the bare-"/etc" loop above. Deliberately scoped by
    # filename, NOT a blanket "/etc/" sed like the /usr/ and /var/ loops
    # use: real /etc/initrd-release checks (initrd-parse-etc.service and
    # ~20 siblings) and systemd-sysext-initrd.service/-sysroot.service's
    # own /etc/extensions are genuinely about the INITRD's (quantra-ramfs)
    # own, separate, transient root filesystem -- not zairoot's overlayer
    # -- rewriting those would be a new bug, not a fix. Only the units
    # below run after switch-root, against the real Zainium root.
    unitdir="$PAYLOAD_DIR/overlayer/syshub/lib/systemd/system"
    [ -f "$unitdir/systemd-machine-id-commit.service" ] && sed -i 's#/etc/machine-id#/overlayer/syshub/etc/machine-id#' "$unitdir/systemd-machine-id-commit.service"
    [ -f "$unitdir/ldconfig.service" ] && sed -i 's#/etc/ld\.so\.cache#/overlayer/syshub/etc/ld.so.cache#' "$unitdir/ldconfig.service"
    [ -f "$unitdir/systemd-hwdb-update.service" ] && sed -i 's#/etc/udev/#/overlayer/syshub/etc/udev/#g' "$unitdir/systemd-hwdb-update.service"
    [ -f "$unitdir/system-update-cleanup.service" ] && sed -i 's#/etc/system-update#/overlayer/syshub/etc/system-update#g' "$unitdir/system-update-cleanup.service"
    [ -f "$unitdir/systemd-binfmt.service" ] && sed -i 's#/etc/binfmt\.d#/overlayer/syshub/etc/binfmt.d#' "$unitdir/systemd-binfmt.service"
    [ -f "$unitdir/systemd-modules-load.service" ] && sed -i 's#/etc/modules-load\.d#/overlayer/syshub/etc/modules-load.d#' "$unitdir/systemd-modules-load.service"
    [ -f "$unitdir/systemd-repart.service" ] && sed -i 's#/etc/repart\.d#/overlayer/syshub/etc/repart.d#' "$unitdir/systemd-repart.service"
    [ -f "$unitdir/systemd-sysext.service" ] && sed -i 's#/etc/extensions#/overlayer/syshub/etc/extensions#' "$unitdir/systemd-sysext.service"

    # Fourth instance of the same underlying problem, biggest one yet:
    # ~28 unit files across lib/systemd/{system,user} ship
    # Exec{Start,Stop,Reload}*= lines that invoke one of systemd's OWN
    # internal helper binaries (systemd-tmpfiles, systemd-sysusers,
    # systemd-hwdb, udevadm, userdbctl, journalctl, systemctl,
    # networkctl, systemd-firstboot, systemd-repart, systemd-sysext,
    # systemd-confext, systemd-nspawn, systemd-mute-console,
    # systemd-machine-id-setup, systemd-sysupdate, systemd-sysinstall,
    # systemd-tty-ask-password-agent, ...) by BARE NAME, relying on
    # PATH search to find them at exec time -- confirmed via real boot
    # journal, 2026-09-04 ("Unable to locate executable 'X': No such
    # file or directory", "Failed at step EXEC spawning X"). Zainium's
    # PATH (wired via DefaultEnvironment in system.conf.d, see the
    # sibling drop-in this package doesn't ship) wasn't taking effect
    # for these units at the point this was diagnosed, so relying on
    # PATH resolution at all is fragile here -- give every one of these
    # an absolute path instead, sidestepping that dependency entirely
    # (same fix real systemd's @rootlibexecdir@-templated .service.in
    # files are supposed to produce automatically; ours apparently
    # weren't templating that for some of these).
    for unitdir in "$PAYLOAD_DIR/overlayer/syshub/lib/systemd/system" "$PAYLOAD_DIR/overlayer/syshub/lib/systemd/user"; do
        [ -d "$unitdir" ] || continue
        for f in "$unitdir"/*.service; do
            [ -f "$f" ] || continue
            sed -i -E 's#^(Exec(Start|Stop|Reload)[a-zA-Z]*=)(systemctl|journalctl|networkctl|resolvectl|timedatectl|hostnamectl|loginctl|localectl|machinectl|coredumpctl|bootctl|portablectl|homectl|oomctl|busctl|udevadm|userdbctl|systemd-[a-zA-Z0-9_-]*)([[:space:]]|$)#\1/overlayer/syshub/bin/\3\4#' "$f"
        done
    done
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_systemd-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_systemd-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
