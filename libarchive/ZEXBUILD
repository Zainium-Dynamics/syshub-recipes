maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libarchive
pkgver=3.8.9
pkgrel=0
subpackages="libarchive-dev"
source="https://libarchive.org/downloads/libarchive-$pkgver.tar.gz"
sha256sums="f5a6539059cf5e597dbeda37bfa4874b1e8dea063c8d93bf85a2b44af90a5bd4  libarchive-$pkgver.tar.gz"
makedepends="acl-dev attr-dev bsd-compat-headers bzip2-dev expat-dev lz4-dev openssl-dev xz-dev zlib-dev zstd-dev"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --without-xml2
    make -j"$(nproc)"
    make DESTDIR="$(pwd)/_zexbuild-install" install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin"
    find "$inst/lib" -maxdepth 1 -name 'libarchive.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
