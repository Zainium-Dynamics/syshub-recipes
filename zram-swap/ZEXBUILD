maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=zram-swap
pkgver=1.0
pkgrel=0
source="zram-swap
zram-swap.service
60-zram.conf"
sha256sums=""

# Compressed swap in RAM at boot (zram, zstd), enabled through swap.target
build() {
    :
}

package() {
    install -Dm755 "$SRCDIR/zram-swap" "$PAYLOAD_DIR/libexec/zram-swap"
    install -Dm644 "$SRCDIR/zram-swap.service" "$PAYLOAD_DIR/lib/systemd/system/zram-swap.service"
    install -Dm644 "$SRCDIR/60-zram.conf" "$PAYLOAD_DIR/lib/sysctl.d/60-zram.conf"
    mkdir -p "$PAYLOAD_DIR/etc/systemd/system/swap.target.wants"
    ln -sf /overlayer/syshub/lib/systemd/system/zram-swap.service \
        "$PAYLOAD_DIR/etc/systemd/system/swap.target.wants/zram-swap.service"
}
