maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=dbus
pkgver=1.16.0
pkgrel=0
subpackages="$pkgname-dev"
source="https://gitlab.freedesktop.org/dbus/dbus/-/archive/dbus-$pkgver/dbus-dbus-$pkgver.tar.gz"
sha256sums="d2ca9d958c830e762ba70aea8e6b5c29fa7b58d0fee8ddd9bb5a00f35106ab57  dbus-dbus-$pkgver.tar.gz"
makedepends="meson ninja pkgconf expat-dev libapparmor-dev audit-dev libselinux-dev glib-dev"
needs_toolchain="systemd systemd-dev"

build() {
    cd "dbus-dbus-$pkgver"
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    # selinux/libaudit auto-detected enabled (makedepends pulls in
    # libselinux-dev/audit-dev) but their .so runtime libs never made
    # it into any deployed package -- dbus-daemon relocation errors at
    # every boot (avc_open, audit_open, selinux_policy_root, ... symbol
    # not found), confirmed via real boot journal 2026-09-04. Zainium
    # doesn't use SELinux (systemd's own build has -Dselinux=disabled
    # too), so disable outright rather than chase down libs for a
    # feature nothing uses. AppArmor is real and wanted here (unlike
    # selinux) but the same problem applies today -- no libapparmor.so
    # deployed yet either -- so 'auto' rather than 'enabled': meson
    # quietly turns it off if the lib isn't there instead of a hard
    # configure failure, and it comes back on its own the day the
    # apparmor package actually ships the runtime library.
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        -Dselinux=disabled \
        -Dlibaudit=disabled \
        -Dapparmor=auto \
        -Dsystemd=enabled \
        -Dsystemd_system_unitdir=/overlayer/syshub/lib/systemd/system \
        -Dsystemd_user_unitdir=/overlayer/syshub/lib/systemd/user
    ninja -C builddir
}

package() {
    DESTDIR="$PAYLOAD_DIR" ninja -C builddir install

    mkdir -p "$STAGING_ROOT/_dbus-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_dbus-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_dbus-dev/pkgconfig"

    is_text_file() {
        case "$(file -b --mime-type "$1")" in
            text/*) return 0 ;;
            *) return 1 ;;
        esac
    }

    for f in $(grep -rIl "/usr/" "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i \
            -e 's#/usr/lib/#/overlayer/syshub/lib/#g' \
            -e 's#/usr/sbin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/bin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/share/#/overlayer/syshub/share/#g' \
            -e 's#/usr/#/overlayer/syshub/#g' \
            "$f"
    done

    # meson never auto-detected systemd here (no pkg-config/headers for
    # it during THIS package's own build, same bootstrap-ordering class
    # of problem util-linux/systemd have with each other) -- dbus.service
    # / dbus.socket, the actual system-bus daemon's own units, never got
    # installed. Only the D-Bus-*activated* per-service units
    # (dbus-org.freedesktop.login1.service etc, which just proxy to an
    # already-running bus) exist without it. Confirmed real-world impact:
    # systemd-logind fails with "Failed to connect to system bus: No
    # such file or directory" at boot, 2026-09-04 -- logind absolutely
    # requires the system bus, this isn't an edge case. Ship them by
    # hand until dbus's own meson correctly emits these.
    unitdir="$PAYLOAD_DIR/overlayer/syshub/lib/systemd/system"
    mkdir -p "$unitdir/multi-user.target.wants" "$unitdir/sockets.target.wants"
    cat > "$unitdir/dbus.service" <<'EOF'
[Unit]
Description=D-Bus System Message Bus
Documentation=man:dbus-daemon(1)
Requires=dbus.socket

[Service]
ExecStart=/overlayer/syshub/bin/dbus-daemon --system --address=systemd: --nofork --nopidfile --systemd-activation --syslog-only
ExecReload=/overlayer/syshub/bin/dbus-daemon --system --address=systemd: --nofork --nopidfile --systemd-activation --syslog-only
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
EOF
    cat > "$unitdir/dbus.socket" <<'EOF'
[Unit]
Description=D-Bus System Message Bus Socket

[Socket]
ListenStream=/run/dbus/system_bus_socket

[Install]
WantedBy=sockets.target
EOF
    ln -sf ../dbus.service "$unitdir/multi-user.target.wants/dbus.service"
    ln -sf ../dbus.socket "$unitdir/sockets.target.wants/dbus.socket"
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_dbus-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_dbus-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
