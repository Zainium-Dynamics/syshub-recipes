maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=musl-obstack
pkgver=1.2.3
pkgrel=0
subpackages="$pkgname-dev"
source="https://github.com/void-linux/musl-obstack/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="9ffb3479b15df0170eba4480e51723c3961dbe0b461ec289744622db03a69395  v$pkgver.tar.gz"
makedepends="autoconf automake libtool"

# obstack for musl, which doesn't have it: elfutils' eu-ar, eu-nm and eu-ranlib use it
build() {
    autoreconf -fi
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --disable-static
    make -j"$(nproc)"
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    cp -P "$inst"/lib/libobstack.so.* "$PAYLOAD_DIR/lib/"
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/obstack.h "$PAYLOAD_DIR/include/"
    cp -P "$inst"/lib/libobstack.so "$PAYLOAD_DIR/lib/"
    cp -a "$inst"/lib/pkgconfig/musl-obstack.pc "$PAYLOAD_DIR/lib/pkgconfig/"
}
