maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=shared-mime-info
pkgver=2.5.1
pkgrel=0
source="https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/$pkgver/shared-mime-info-$pkgver.tar.gz"
sha256sums="ea248ea157b7fa0165f4fe282c84919fa84c3f175553642f229c8f1ab7539128  shared-mime-info-$pkgver.tar.gz"
makedepends="meson gettext"
needs_toolchain="glib glib-dev pcre2 pcre2-dev libffi libffi-dev zlib zlib-dev gettext gettext-dev libxml2 libxml2-dev"

build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    meson setup builddir \
        --wrap-mode=nofallback \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        -Dupdate-mimedb=false \
        -Dbuild-tests=false \
        -Dbuild-spec=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    cp -a "$inst"/bin/update-mime-database "$PAYLOAD_DIR/bin/"
    cp -a "$inst"/share/mime "$PAYLOAD_DIR/share/"
    if [ -d "$inst/share/locale" ]; then
        cp -a "$inst"/share/locale "$PAYLOAD_DIR/share/"
    fi
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
    # the compiled database is what apps read: without it every file looks like text
    # (COSMIC Files opened videos and images in the text editor)
    export LD_LIBRARY_PATH=/usr/lib:/lib
    local update=builddir/src/update-mime-database
    [ -x "$update" ] || update=update-mime-database
    "$update" "$PAYLOAD_DIR/share/mime"
    [ -s "$PAYLOAD_DIR/share/mime/mime.cache" ]
}
