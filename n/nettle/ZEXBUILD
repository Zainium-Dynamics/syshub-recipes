maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=nettle
pkgver=4.0
pkgrel=0
subpackages="nettle-dev"
source="https://ftp.gnu.org/gnu/nettle/nettle-$pkgver.tar.gz"
sha256sums="3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094  nettle-$pkgver.tar.gz"
makedepends="gmp-dev"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --enable-shared \
        --disable-static \
        --disable-documentation
    make -j"$(nproc)" LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
}

package() {
    make install DESTDIR="$PAYLOAD_DIR"

    mkdir -p "$STAGING_ROOT/_nettle-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_nettle-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_nettle-dev/pkgconfig"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_nettle-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_nettle-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
