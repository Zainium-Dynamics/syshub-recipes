maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=userutiles
pkgver=1.1.0
pkgrel=0
source="https://github.com/Zainium-Dynamics/userutiles/archive/33f8df9a6149ab51c8e89d367ab537d3e4f085fa.tar.gz"
sha256sums=""
makedepends="rustup"
needs_toolchain="musl gcc-musl"

build() {
    cd userutiles-*/
    export PATH="/overlayer/syshub/bin:$PATH"
    rustup-init -y -q --profile minimal --default-toolchain stable --target x86_64-unknown-linux-musl
    export PATH="$HOME/.cargo/bin:$PATH"

    RUSTFLAGS="-C target-feature=-crt-static -L/overlayer/syshub/lib" \
        cargo build --release --workspace --target x86_64-unknown-linux-musl \
        --config 'target.x86_64-unknown-linux-musl.linker="x86_64-zainium-linux-musl-gcc"'
}

package() {
    local out="target/x86_64-unknown-linux-musl/release"
    mkdir -p "$PAYLOAD_DIR/bin"

  
    find "$out" -maxdepth 1 -type f -executable ! -name '*.*' -print0 |
    while IFS= read -r -d '' f; do
        cp "$f" "$PAYLOAD_DIR/bin/$(basename "$f")"
    done

    strip "$PAYLOAD_DIR/bin/"* 2>/dev/null || true
}
