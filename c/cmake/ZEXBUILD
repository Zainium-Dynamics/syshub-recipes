maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cmake
pkgver=4.4.2
pkgrel=0
subpackages=""
source="https://github.com/Kitware/CMake/releases/download/v$pkgver/cmake-$pkgver.tar.gz"
sha256sums="1db9e61e60b6e0874c86386340b910382f3c5e75b9fbfb44d122063129a2789d  cmake-$pkgver.tar.gz"
makedepends="curl-dev libarchive-dev zlib-dev xz-dev ncurses-dev g++ bzip2-dev make"

build() {
    export LD_LIBRARY_PATH=/usr/lib:/lib
    CC=gcc CXX=g++ ./bootstrap \
        --prefix=/overlayer/syshub \
        --system-curl \
        --system-zlib \
        --system-bzip2 \
        --system-liblzma \
        --system-libarchive \
        --no-qt-gui \
        --parallel=$(nproc)
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
}
