maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cups
pkgver=2.4.11
pkgrel=0
subpackages="cups-dev"
source="https://github.com/OpenPrinting/cups/releases/download/v$pkgver/cups-$pkgver-source.tar.gz"
sha256sums="9a88fe1da3a29a917c3fc67ce6eb3178399d68e1a548c6d86c70d9b13651fd71  cups-$pkgver-source.tar.gz"
# All toolchain libs are Zainium's own; PAM is elevate-pam (our Rust PAM).
needs_toolchain="gcc-musl zlib zlib-dev gnutls gnutls-dev dbus dbus-dev systemd libusb libusb-dev avahi avahi-dev elevate-pam"
makedepends="pkgconf"

# CUPS print server + libcups. Driverless (IPP Everywhere) over Avahi, USB
# printing via libusb, TLS via GnuTLS, auth via elevate-pam. No systemd unit,
# no Kerberos. cups-filters builds on top of this.
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --sbindir=/overlayer/syshub/bin \
        --with-rundir=/overlayer/syshub/run/cups \
        --with-logdir=/overlayer/syshub/var/log/cups \
        --with-cachedir=/overlayer/syshub/var/cache/cups \
        --with-tls=gnutls \
        --enable-libusb \
        --enable-avahi \
        --enable-dbus \
        --enable-pam \
        --disable-systemd \
        --disable-gssapi \
        --disable-tcp-wrappers \
        --without-rcdir \
        --without-icondir \
        --without-menudir \
        --disable-static
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/etc" "$PAYLOAD_DIR/share"
    # libcups*.so* plus the cups/ filters+backends dir live under lib
    cp -a "$inst/lib/." "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/etc/." "$PAYLOAD_DIR/etc/" 2>/dev/null || true
    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
    # drop static archives, docs, man, locale and build-time cups-config stays in bin
    find "$PAYLOAD_DIR/lib" -name '*.a' -delete 2>/dev/null || true
    rm -rf "$PAYLOAD_DIR/share/man" "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/locale"
    rm -rf "$PAYLOAD_DIR/include"
    :
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    if [ -d "$inst/lib/pkgconfig" ]; then
        mkdir -p "$PAYLOAD_DIR/lib/pkgconfig"
        cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
    fi
}
