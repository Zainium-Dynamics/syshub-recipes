maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cryptsetup
pkgver=2.8.8
pkgrel=1
source="https://www.kernel.org/pub/linux/utils/cryptsetup/v${pkgver%.*}/cryptsetup-$pkgver.tar.xz"
sha256sums="3acfa685f2dd7fcc832e0b77bc7093aa7da554a51ce8dafbb4138eaa854eee35  cryptsetup-$pkgver.tar.xz"
makedepends="pkgconf lvm2-dev json-c-dev util-linux-dev popt-dev popt-static linux-headers gettext-dev"
needs_toolchain="openssl openssl-dev"

# The library (udisks and libblockdev open LUKS drives through it) and the cryptsetup
# command, which the installer uses to encrypt a disk and quantra-ramfs to open it at boot.
# The command's option parser, popt, is not in the base, so it is linked in statically.
build() {
    # only Alpine's libpopt.a is left for -lpopt (build machine only, not packaged)
    rm -f /usr/lib/libpopt.so
    # Zainium's openssl, not Alpine's: its libcrypto has another soname
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --sbindir=/overlayer/syshub/bin \
        --libdir=/overlayer/syshub/lib \
        --libexecdir=/overlayer/syshub/libexec \
        --disable-static \
        --with-tmpfilesdir=/overlayer/syshub/lib/tmpfiles.d \
        --with-crypto_backend=openssl \
        --disable-asciidoc \
        --disable-ssh-token \
        --disable-veritysetup \
        --disable-integritysetup \
        --disable-selinux
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    # runtime only: headers, pkgconfig, static archives and docs stay out of the base
    rm -rf "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/share/man" \
        "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/gtk-doc" "$PAYLOAD_DIR/share/info"
    find "$PAYLOAD_DIR" \( -name '*.a' -o -name '*.la' \) -delete
}
