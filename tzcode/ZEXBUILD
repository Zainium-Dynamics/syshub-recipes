maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=tzcode
pkgver=2026c
pkgrel=0
source="https://data.iana.org/time-zones/releases/tzcode$pkgver.tar.gz"
sha256sums="b1cffc3ace4c4c7cd0efba2f7add86ec3d0b79da48bcf03582671fd3c8feace8  tzcode$pkgver.tar.gz"

# IANA tz database code -- zic (zoneinfo compiler) + zdump. Native
# Alpine build (plain C), only final interpreter/rpath pinned to
# Zainium's musl, same pattern as util-linux.
build() {
    cd "tzcode$pkgver" 2>/dev/null || true
    export LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
    make zic zdump
}

package() {
    mkdir -p "$PAYLOAD_DIR/bin"
    cp zic zdump "$PAYLOAD_DIR/bin/"
    strip "$PAYLOAD_DIR/bin/"* 2>/dev/null || true
}
