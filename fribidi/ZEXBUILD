maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=fribidi
pkgver=1.0.17
pkgrel=0
subpackages="$pkgname-dev"
source="https://github.com/fribidi/fribidi/releases/download/v$pkgver/fribidi-$pkgver.tar.xz"
sha256sums="6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2  fribidi-$pkgver.tar.xz"
makedepends="meson ninja pkgconf"

# Unicode bidirectional text (Arabic, Hebrew, ...) for pango
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        -Ddocs=false \
        -Dbin=false \
        -Dtests=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    cp -P "$inst"/lib/libfribidi.so.* "$PAYLOAD_DIR/lib/"
    [ -e "$PAYLOAD_DIR/lib/libfribidi.so.0" ]
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -P "$inst"/lib/libfribidi.so "$PAYLOAD_DIR/lib/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
