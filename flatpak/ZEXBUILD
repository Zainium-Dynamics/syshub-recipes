maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=flatpak
pkgver=1.18.1
pkgrel=0
subpackages="flatpak-dev"
source="https://github.com/flatpak/flatpak/releases/download/$pkgver/flatpak-$pkgver.tar.xz"
sha256sums="bc683fc916ed21c0524bb064f358c2ac18586b8ec88c76f2f7f289877521631c  flatpak-$pkgver.tar.xz"
makedepends="libcap-dev libarchive-dev glib-dev curl-dev libxml2-dev fuse3-dev fuse3 ostree-dev json-glib-dev appstream-dev gdk-pixbuf-dev gpgme-dev libseccomp-dev zstd-dev bison git"

# Minimal first pass, same spirit as appstream/pipewire's initial builds:
# docs/gir/systemd/dconf/selinux/malcontent/xauth all disabled to avoid
# their own dependency chains for now. system_bubblewrap/system_dbus_proxy
# left at their default empty string -- meson vendors both as subprojects
# (subprojects/bubblewrap.wrap, subprojects/dbus-proxy.wrap) instead of
# needing separate Zainium packages for a first pass.
build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --libdir=/overlayer/syshub/lib \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Dinternal_tests=false \
        -Dinternal_checks=false \
        -Dauto_sideloading=false \
        -Dgdm_env_file=false \
        -Dman=disabled \
        -Ddocbook_docs=disabled \
        -Dgtkdoc=disabled \
        -Dgir=disabled \
        -Dmalcontent=disabled \
        -Dsystemd=disabled \
        -Dselinux_module=disabled \
        -Dwayland_security_context=disabled \
        -Ddconf=disabled \
        -Dxauth=disabled \
        -Dsystem_helper=disabled \
        -Ddbus_config_dir=/overlayer/syshub/share/dbus-1/system.d \
        -Ddbus_service_dir=/overlayer/syshub/share/dbus-1/services \
        -Dprivileged_group=wheel
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    rm -rf "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    # Compiled-in default (/overlayer/syshub/var/lib/flatpak) is on the
    # read-only lowerdir and never actually gets used -- installations.d
    # overrides the "default" installation's path to the writable
    # upperdir instead. See gnomesoftware.md.
    mkdir -p "$PAYLOAD_DIR/etc/flatpak/installations.d"
    cat > "$PAYLOAD_DIR/etc/flatpak/installations.d/zainium.conf" <<'EOF'
[Installation "default"]
Path=/overlayer/zexlib/union/var/lib/flatpak
EOF
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
