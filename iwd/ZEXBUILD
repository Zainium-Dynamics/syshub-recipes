maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=iwd
pkgver=3.12
pkgrel=0
makedepends="autoconf automake libtool pkgconf git readline-dev"
needs_toolchain="ell ell-dev dbus dbus-dev"

build() {
    git clone --branch "$pkgver" --depth 1 https://git.kernel.org/pub/scm/network/wireless/iwd.git "iwd-$pkgver"
    cd "iwd-$pkgver"
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
    ./bootstrap
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --libdir=/overlayer/syshub/lib \
        --localstatedir=/overlayer/syshub/var \
        --enable-external-ell \
        --enable-wired \
        --disable-manual-pages \
        --with-dbus-datadir=/overlayer/syshub/share \
        --with-dbus-busdir=/overlayer/syshub/share/dbus-1/system-services \
        --with-systemd-unitdir=/overlayer/syshub/lib/systemd/system \
        --with-systemd-networkdir=/overlayer/syshub/lib/systemd/network \
        --with-systemd-modloaddir=/overlayer/syshub/lib/modules-load.d
    make -j"$(nproc)"
}

package() {
    make -C "iwd-$pkgver" install DESTDIR="$PAYLOAD_DIR"

    is_text_file() {
        case "$(file -b --mime-type "$1")" in
            text/*) return 0 ;;
            *) return 1 ;;
        esac
    }

    for f in $(grep -rIl "/usr/" "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i \
            -e 's#/usr/lib/#/overlayer/syshub/lib/#g' \
            -e 's#/usr/sbin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/bin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/share/#/overlayer/syshub/share/#g' \
            -e 's#/usr/#/overlayer/syshub/#g' \
            "$f"
    done

    strip "$PAYLOAD_DIR/overlayer/syshub/bin/"* "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}
