maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=libseccomp
pkgver=2.6.1
pkgrel=0
subpackages="libseccomp-dev"
source="https://github.com/seccomp/libseccomp/releases/download/v$pkgver/libseccomp-$pkgver.tar.gz"
sha256sums="501f66c667225d53791b97e1d7cf85ab764c297d04881f60f38f451c4b0ee1be  libseccomp-$pkgver.tar.gz"
makedepends="gperf"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --enable-shared \
        --enable-static
    make -j"$(nproc)"
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libseccomp.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/bin"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp "$inst/lib/libseccomp.a" "$PAYLOAD_DIR/lib/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
    cp "$inst/bin/scmp_sys_resolver" "$PAYLOAD_DIR/bin/"
}
