maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libxml2
pkgver=2.15.3
pkgrel=0
subpackages="libxml2-dev"
source="https://gitlab.gnome.org/GNOME/libxml2/-/archive/v$pkgver/libxml2-v$pkgver.tar.gz"
sha256sums="0da50c1415f4ec0364569d2119b1436ba837b31df44af28569d234272c23cf1f  libxml2-v$pkgver.tar.gz"
makedepends="zlib-dev"

build() {
    cd libxml2-v$pkgver
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        -Dzlib=enabled \
        -Dpython=disabled \
        -Dicu=disabled \
        -Dreadline=disabled \
        -Dhistory=disabled \
        -Dtests=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin"
    find "$inst/lib" -maxdepth 1 -name 'libxml2.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
