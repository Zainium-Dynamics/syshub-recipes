maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libpsl
pkgver=0.23.3
pkgrel=0
subpackages="libpsl-dev"
source="https://github.com/rockdaboot/libpsl/releases/download/$pkgver/libpsl-$pkgver.tar.gz"
sha256sums="93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be  libpsl-$pkgver.tar.gz"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --enable-shared \
        --disable-static \
        --enable-builtin \
        --enable-runtime=no
    make -j"$(nproc)"
}

package() {
    make install DESTDIR="$PAYLOAD_DIR"

    mkdir -p "$STAGING_ROOT/_libpsl-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_libpsl-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_libpsl-dev/pkgconfig"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_libpsl-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_libpsl-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
