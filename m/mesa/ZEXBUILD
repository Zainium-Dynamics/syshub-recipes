maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=mesa
pkgver=26.2.1
pkgrel=3
subpackages="mesa-dev"
source="https://gitlab.freedesktop.org/mesa/mesa/-/archive/mesa-$pkgver/mesa-mesa-$pkgver.tar.gz"
sha256sums="47d057dd1a6f226f8c48612e371c69c3c17ea1f3a97a7d674f786e0c84c8bb5a  mesa-mesa-$pkgver.tar.gz"
makedepends="meson samurai glslang py3-mako py3-packaging py3-yaml llvm22-dev llvm22-static spirv-llvm-translator-dev spirv-tools-dev clang22-dev clang22-static libdrm-dev wayland-dev wayland-protocols zlib-dev zstd-dev elfutils-dev python3 rust cargo bison flex"
needs_toolchain="libglvnd libglvnd-dev libdrm libdrm-dev wayland wayland-dev wayland-protocols zlib zlib-dev zstd zstd-dev elfutils elfutils-dev"

# x86_64-relevant drivers only. With glvnd, libglvnd owns libEGL, libGLESv2 and
# libOpenGL, and Mesa adds libEGL_mesa and its vendor file in share/glvnd.
build() {
    cd mesa-mesa-$pkgver
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig:/overlayer/zexlib/union/lib/pkgconfig"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        -Dplatforms=wayland \
        -Degl=enabled \
        -Dgbm=enabled \
        -Dgles1=disabled \
        -Dgles2=enabled \
        -Dopengl=true \
        -Dglx=disabled \
        -Dglvnd=enabled \
        -Dllvm=enabled \
        -Dgallium-drivers=crocus,i915,iris,llvmpipe,nouveau,r300,r600,radeonsi,softpipe,svga,virgl,zink \
        -Dvulkan-drivers=amd,intel,intel_hasvk,nouveau,swrast,virtio \
        -Dgallium-rusticl=false \
        -Dspirv-to-dxil=false \
        -Dspirv-tools=enabled \
        -Dmesa-clc=enabled \
        -Dxmlconfig=disabled \
        -Dexpat=disabled \
        -Dtools= \
        -Dbuildtype=release
    LD_LIBRARY_PATH=/usr/lib:/lib ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="mesa-mesa-$pkgver/_zexbuild-install/overlayer/syshub"
    [ -d "$inst" ] || inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/share"
    cp -a "$inst/lib/." "$PAYLOAD_DIR/lib/"
    rm -rf "$PAYLOAD_DIR/lib/pkgconfig"

    # Ensure unversioned .so symlinks exist (e.g. libEGL.so -> libEGL.so.1)
    cd "$PAYLOAD_DIR/lib"
    for lib in lib*.so.[0-9]*; do
        [ -e "$lib" ] || continue
        base="${lib%%.so.*}.so"
        [ -L "$base" ] || [ -e "$base" ] || ln -sf "$lib" "$base"
    done
    cd - >/dev/null

    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
}

dev() {
    local inst="mesa-mesa-$pkgver/_zexbuild-install/overlayer/syshub"
    [ -d "$inst" ] || inst="_zexbuild-install/overlayer/syshub"

    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true

    # Copy unversioned .so symlinks into mesa-dev as well so linker always finds them
    cd "$inst/lib"
    for link in lib*.so; do
        [ -L "$link" ] && cp -a "$link" "$PAYLOAD_DIR/lib/"
    done
    cd - >/dev/null
}
