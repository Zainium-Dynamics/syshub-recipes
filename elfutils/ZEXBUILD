maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=elfutils
pkgver=0.195
pkgrel=0
subpackages="elfutils-dev"
# musl-compat patches from Alpine's own elfutils APKBUILD (their
# musl-macros.patch + fix-uninitialized.patch, both x86-relevant;
# skipped their aarch64/ppc-only patches). debuginfod/libdebuginfod
# disabled -- pulls in json-c/libarchive/libmicrohttpd/sqlite for a
# feature the base OS doesn't need.
source="https://sourceware.org/elfutils/ftp/$pkgver/elfutils-$pkgver.tar.bz2
0001-musl-macros.patch
0002-fix-uninitialized-x86-disasm.patch"
sha256sums="37629fdf7f1f3dc2818e138fca2b8094177d6c2d0f701d3bb650a561218dc026  elfutils-$pkgver.tar.bz2"
makedepends="argp-standalone bsd-compat-headers musl-fts-dev musl-libintl musl-obstack-dev xz-dev bzip2-dev"

build() {
    patch -p1 < ../0001-musl-macros.patch
    patch -p1 < ../0002-fix-uninitialized-x86-disasm.patch

    CFLAGS="${CFLAGS:-} -D_GNU_SOURCE -Wno-error -Wno-null-dereference" \
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --disable-werror \
        --program-prefix=eu- \
        --enable-deterministic-archives \
        --disable-nls \
        --disable-debuginfod \
        --disable-libdebuginfod \
        --with-zstd
    make -j"$(nproc)"
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin"
    find "$inst/lib" -maxdepth 1 -name '*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/"
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    find "$inst/lib" -maxdepth 1 -name '*.a' -exec cp {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
