maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=e2fsprogs
pkgver=1.47.4
pkgrel=0
subpackages="e2fsprogs-dev"
source="https://github.com/tytso/e2fsprogs/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="9f82eaa7002673291629077b80ee005cadfcd49854907a22007fed70b0ef596e  v$pkgver.tar.gz"
makedepends="util-linux-dev pkgconf"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --sbindir=/overlayer/syshub/bin \
        --localstatedir=/overlayer/syshub/var \
        --enable-fsck \
        --enable-uuidd \
        --enable-libuuid \
        --enable-libblkid \
        --enable-elf-shlibs
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
    DESTDIR="$(pwd)/_zexbuild-install" make install-libs
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share" "$PAYLOAD_DIR/etc"
    find "$inst/lib" -maxdepth 1 -name '*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/sbin/." "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    cp -a "$inst/share/." "$PAYLOAD_DIR/share/" 2>/dev/null || true
    cp -a "$inst/etc/." "$PAYLOAD_DIR/etc/" 2>/dev/null || true
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
