maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=gcc-musl
pkgver=16.2.0
pkgrel=0
source="https://ftp.gnu.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.gz
0001-zainium-musl-paths.patch"
sha256sums="071d00a097579e5ef7ce97fc4a9e58e73fd3503c0a013c765c970370a5a53b9b  gcc-$pkgver.tar.gz"
makedepends="build-base bzip2 xz wget"
needs_toolchain="musl gcc-musl binutils zlib zlib-dev zstd zstd-dev"

build() {
    local sysroot=/overlayer/syshub
    local triple=x86_64-zainium-linux-musl
    local musl_root="$sysroot/$triple"
    local old
    old="$(ls "$sysroot/lib/gcc/$triple" | head -1)"
    local ldso="$musl_root/lib/ld-musl-x86_64.so.1"
    local rpath="-Wl,-rpath=$sysroot/lib:$musl_root/lib"

    cd "$SRCDIR/gcc-$pkgver"
    patch -p1 < "$SRCDIR/0001-zainium-musl-paths.patch"
    ./contrib/download_prerequisites

    mkdir -p "$SRCDIR/gcc-build"
    cd "$SRCDIR/gcc-build"

    export CC="$sysroot/bin/$triple-gcc -B$sysroot/lib/gcc/$triple/$old/"
    export CXX="$sysroot/bin/$triple-g++ -B$sysroot/lib/gcc/$triple/$old/"
    export CC_FOR_BUILD=/usr/bin/gcc
    export CXX_FOR_BUILD=/usr/bin/g++
    export AR="$sysroot/bin/$triple-ar" AS="$sysroot/bin/$triple-as" LD="$sysroot/bin/$triple-ld"
    export NM="$sysroot/bin/$triple-nm" RANLIB="$sysroot/bin/$triple-ranlib"
    for t in AR AS LD NM RANLIB OBJCOPY OBJDUMP STRIP READELF; do
        export "${t}_FOR_TARGET=$sysroot/bin/$triple-$(echo "$t" | tr 'A-Z' 'a-z')"
    done
    export CFLAGS="-O2 -pipe"
    export CXXFLAGS="-O2 -pipe -isystem $sysroot/include/c++/$old -isystem $sysroot/include/c++/$old/$triple"
    export CFLAGS_FOR_TARGET="-O2 -pipe"
    export CXXFLAGS_FOR_TARGET="-O2 -pipe"
    export LDFLAGS="-Wl,-dynamic-linker=$ldso $rpath"
    export LDFLAGS_FOR_TARGET="-Wl,-dynamic-linker=$ldso $rpath"

    "$SRCDIR/gcc-$pkgver/configure" \
        --build=x86_64-linux-gnu \
        --host=$triple \
        --target=$triple \
        --prefix=$sysroot \
        --bindir=$sysroot/bin \
        --libdir=$sysroot/lib \
        --libexecdir=$sysroot/lib \
        --with-sysroot=$musl_root \
        --with-native-system-header-dir=/include \
        --with-local-prefix=$sysroot \
        --with-toolexeclibdir=$sysroot/lib \
        --with-gxx-include-dir=$sysroot/include/c++/16 \
        --with-system-zlib \
        --with-zstd=$sysroot \
        --with-pkgversion="GCC 16 (Zainium OS 16)" \
        --with-gcc-major-version-only \
        --with-bugurl=https://zainiumdynamics.tech \
        --enable-languages=c,c++ \
        --enable-lto \
        --enable-threads=posix \
        --enable-tls \
        --enable-shared \
        --enable-default-pie \
        --enable-default-ssp \
        --disable-bootstrap \
        --disable-multilib \
        --disable-multiarch \
        --disable-nls \
        --disable-libsanitizer \
        --disable-libquadmath \
        --disable-libquadmath-support \
        --disable-libgomp \
        --disable-libitm \
        --disable-libssp \
        --disable-libstdcxx-pch \
        --disable-werror
    make -j"$(nproc)"
    make DESTDIR="$SRCDIR/gcc-install" install
}

package() {
    local triple=x86_64-zainium-linux-musl
    local inst="$SRCDIR/gcc-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    if find "$PAYLOAD_DIR" -name 'lib64*' | grep -q .; then
        echo "gcc installed lib64 paths:" >&2
        find "$PAYLOAD_DIR" -name 'lib64*' >&2
        return 1
    fi
    if find "$PAYLOAD_DIR" -type l -lname '*lib64*' | grep -q .; then
        echo "gcc installed symlinks to lib64:" >&2
        find "$PAYLOAD_DIR" -type l -lname '*lib64*' >&2
        return 1
    fi
    [ -d "$PAYLOAD_DIR/lib/gcc/$triple" ] || { echo "no lib/gcc/$triple in the payload" >&2; return 1; }

    for so in libstdc++ libatomic libgcc_s; do
        real="$(ls "$PAYLOAD_DIR"/lib/$so.so.[0-9]*.* 2>/dev/null | head -1)"
        [ -n "$real" ] || continue
        major="$(basename "$real" | sed -n "s/^$so\.so\.\([0-9]*\)\..*/\1/p")"
        [ -e "$PAYLOAD_DIR/lib/$so.so.$major" ] || ln -s "$(basename "$real")" "$PAYLOAD_DIR/lib/$so.so.$major"
        [ -e "$PAYLOAD_DIR/lib/$so.so" ] || ln -s "$so.so.$major" "$PAYLOAD_DIR/lib/$so.so"
    done

    cd "$PAYLOAD_DIR/bin"
    [ -e $triple-gcc ] || ln -s gcc $triple-gcc
    [ -e $triple-g++ ] || ln -s g++ $triple-g++
    ln -sf $triple-gcc cc
    cd - >/dev/null

    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
