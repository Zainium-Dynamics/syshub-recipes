build() {
    return 0
}

package() {
    mkdir -p "$PAYLOAD_DIR/share/fonts/ibm-plex-mono" "$PAYLOAD_DIR/etc/fonts/conf.d"
    cp IBMPlexMono-*.ttf "$PAYLOAD_DIR/share/fonts/ibm-plex-mono/"
    cp 60-ibm-plex-mono.conf "$PAYLOAD_DIR/etc/fonts/conf.d/"

    # COSMIC defaults to Noto Sans Mono for the desktop, terminal and editor
    local cosmic="$PAYLOAD_DIR/share/cosmic"
    mkdir -p "$cosmic/com.system76.CosmicTk/v1" "$cosmic/com.system76.CosmicTerm/v1" "$cosmic/com.system76.CosmicEdit/v1"
    printf '(family: "IBM Plex Mono", weight: Normal, stretch: Normal, style: Normal)\n' > "$cosmic/com.system76.CosmicTk/v1/monospace_font"
    printf '"IBM Plex Mono"\n' > "$cosmic/com.system76.CosmicTerm/v1/font_name"
    printf '"IBM Plex Mono"\n' > "$cosmic/com.system76.CosmicEdit/v1/font_name"
}
