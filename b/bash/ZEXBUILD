maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=bash
pkgver=5.3
pkgrel=1
needs_toolchain="musl gcc-musl ncurses ncurses-dev readline readline-dev"
source="https://ftp.gnu.org/gnu/bash/bash-$pkgver.tar.gz
0001-zainium-paths.patch"
sha256sums="0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba  bash-$pkgver.tar.gz"

build() {
    patch -p1 < ../0001-zainium-paths.patch

    local sysroot="/overlayer/syshub"
    local musl_sysroot="${sysroot}/x86_64-zainium-linux-musl"
    local bindir="${sysroot}/bin"
    local runtime_ldso="${musl_sysroot}/lib/ld-musl-x86_64.so.1"

    export CC_FOR_BUILD="/usr/bin/gcc"
    export CFLAGS_FOR_BUILD="-O2 -pipe"

    export CC="${bindir}/x86_64-zainium-linux-musl-gcc"
    export CFLAGS="-O2 -pipe -D_GNU_SOURCE -I${musl_sysroot}/include -I${sysroot}/include -I${sysroot}/include/ncursesw"
    export CPPFLAGS="-D_GNU_SOURCE -I${musl_sysroot}/include -I${sysroot}/include -I${sysroot}/include/ncursesw"
    export LDFLAGS="-L${musl_sysroot}/lib -L${sysroot}/lib -Wl,-dynamic-linker=${runtime_ldso} -Wl,-rpath=${sysroot}/lib"

    export ac_cv_func_mmap_fixed_mapped=yes
    export ac_cv_func_strcoll_works=yes
    export bash_cv_func_sigsetjmp=present
    export bash_cv_getcwd_malloc=yes
    export bash_cv_job_control_missing=present
    export bash_cv_sys_named_pipes=present

    ./configure \
        --host=x86_64-zainium-linux-musl \
        --prefix="$sysroot" \
        --bindir="$sysroot/bin" \
        --libdir="$sysroot/lib" \
        --includedir="$sysroot/include" \
        --without-bash-malloc \
        --enable-readline \
        --enable-history \
        --disable-nls
    make -j"$(nproc)"
}

package() {
    make DESTDIR="$PAYLOAD_DIR" install
    rm -f "$PAYLOAD_DIR/overlayer/syshub/bin/bashbug"
    # docs and info pages are upstream prose full of /usr paths (info files carry byte offsets, so no sed)
    rm -rf "$PAYLOAD_DIR/overlayer/syshub/share/doc/bash" "$PAYLOAD_DIR/overlayer/syshub/share/info"
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
