maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=elevate-pam
pkgver=1.0.1
pkgrel=3
_nightly=nightly-2026-05-24
_commit=9d99ab2fcf47925644290e0e4326befd94e29408
source="https://github.com/Zainium-Dynamics/elevate-pam/archive/$_commit.tar.gz
x86_64-zainium-linux-musl.json"
sha256sums="fcdf55477b1fafdc8212bd80d858bbeb1eafdd3b3049d38e8ee7750c64895e07  $_commit.tar.gz"
makedepends="rustup"
needs_toolchain="musl"

build() {
    local target="$SRCDIR/x86_64-zainium-linux-musl.json"
    cd "elevate-pam-$_commit"

    export LD_LIBRARY_PATH=/usr/lib:/lib
    rustup-init -y -q --default-toolchain none --profile minimal
    export PATH="$HOME/.cargo/bin:$PATH"
    rustup toolchain install "$_nightly" --profile minimal --component rust-src

    export ELEVATE_PAM_CONFIG_PATH=/overlayer/syshub/etc/elevate-pam/elevate-pam.toml
    RUSTFLAGS="-C target-feature=-crt-static -L/overlayer/syshub/lib -C link-arg=-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -C link-arg=-Wl,-rpath=/overlayer/syshub/lib" \
        cargo "+$_nightly" build --release \
        --workspace --features elevate-pam/legacy_pamd \
        -Z json-target-spec \
        --target "$target" \
        -Z build-std=core,alloc,std,panic_abort \
        --config 'target.x86_64-zainium-linux-musl.linker="cc"'
}

package() {
    local out="target/x86_64-zainium-linux-musl/release"
    mkdir -p "$PAYLOAD_DIR/lib/security" "$PAYLOAD_DIR/include/security"

    # elevate dlopens libelevate_pam.so.0; classic libpam.so only with ELEVATE_ALLOW_LIBPAM=1
    cp "$out/libelevate_pam.so" "$PAYLOAD_DIR/lib/libelevate_pam.so.0"
    ln -sf libelevate_pam.so.0 "$PAYLOAD_DIR/lib/libelevate_pam.so"
    cp "$out/libpam.so" "$PAYLOAD_DIR/lib/libpam.so.0"
    ln -sf libpam.so.0 "$PAYLOAD_DIR/lib/libpam.so"
    cp "$out/libpam_misc.so" "$PAYLOAD_DIR/lib/libpam_misc.so.0"
    ln -sf libpam_misc.so.0 "$PAYLOAD_DIR/lib/libpam_misc.so"
    cp "$out/unix_chkpwd" "$PAYLOAD_DIR/lib/security/unix_chkpwd"
    # the PAM modules the stacks in etc/pam.d load: pam_loginuid, pam_keyinit, pam_xauth, ...
    # systemd --user does not start without them
    for f in "$out"/libpam_*.so; do
        b="$(basename "$f")"
        [ "$b" = libpam_misc.so ] && continue
        cp "$f" "$PAYLOAD_DIR/lib/security/${b#lib}"
    done
    [ -f "$PAYLOAD_DIR/lib/security/pam_loginuid.so" ] || { echo "no pam_loginuid.so" >&2; return 1; }
    cp include/security/*.h "$PAYLOAD_DIR/include/security/"

    strip "$PAYLOAD_DIR/lib/"*.so.0 "$PAYLOAD_DIR/lib/security/"* 2>/dev/null || true
    chmod 4755 "$PAYLOAD_DIR/lib/security/unix_chkpwd"

    # Zainium's tested PAM configuration, kept next to this recipe (etc/):
    # elevate-pam's own config and service stacks, pam_env/limits data,
    # /etc/environment, and the classic pam.d files of services no other
    # package configures. pam.d/systemd-user overrides systemd's lib/pam.d
    # copy, whose empty auth stack fails pam_setcred, so a systemd upgrade
    # can't bring that back.
    cp -a "$RECIPE_DIR/etc" "$PAYLOAD_DIR/"
}
