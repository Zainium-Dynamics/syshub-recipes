                             * any message printing. Different distributions place the binary at various places but at
                             * least not in the 'sbin' directory. */
-                           "/bin/false",
-                           "/usr/bin/false",
-                           "/bin/true",
-                           "/usr/bin/true");
+                           "/overlayer/syshub/bin/false",
+                           "/overlayer/syshub/bin/false",
