From: Ali Zain <alizain@zainiumdynamics.tech>
Subject: [PATCH] zainium: system paths under /overlayer/syshub

Config, data and helper paths point into /overlayer/syshub. Image and
container tools keep the stock paths: they read other systems.
---
diff --git a/src/analyze/analyze-unit-shell.c b/src/analyze/analyze-unit-shell.c
index 98dc474..625d370 100644
--- a/src/analyze/analyze-unit-shell.c
+++ b/src/analyze/analyze-unit-shell.c
@@ -106,8 +106,8 @@ int verb_unit_shell(int argc, char *argv[], uintptr_t _data, void *userdata) {
                                 log_debug_errno(errno, "Failed to execute '/bin/bash', ignoring: %m");
                         }
 
-                        if (!streq(DEFAULT_USER_SHELL, "/bin/sh")) {
-                                (void) execl("/bin/sh", "-sh", NULL);
+                        if (!streq(DEFAULT_USER_SHELL, "/overlayer/syshub/bin/bash")) {
+                                (void) execl("/overlayer/syshub/bin/bash", "-sh", NULL);
                                 log_debug_errno(errno, "Failed to execute '/bin/sh', ignoring: %m");
                         }
 
diff --git a/src/basic/constants.h b/src/basic/constants.h
index 3dbffde..a02b1c6 100644
--- a/src/basic/constants.h
+++ b/src/basic/constants.h
@@ -37,16 +37,16 @@
 /* Return a nulstr for a standard cascade of configuration paths, suitable to pass to
  * conf_files_list_nulstr() to implement drop-in directories for extending configuration files. */
 #define CONF_PATHS_NULSTR(n)                    \
-        "/etc/" n "\0"                          \
+        "/overlayer/syshub/etc/" n "\0"                          \
         "/run/" n "\0"                          \
-        "/usr/local/lib/" n "\0"                \
-        "/usr/lib/" n "\0"
+        "/overlayer/syshub/lib/" n "\0"                \
+        "/overlayer/syshub/lib/" n "\0"
 
 #define CONF_PATHS(n)                           \
-        "/etc/" n,                              \
+        "/overlayer/syshub/etc/" n,                              \
         "/run/" n,                              \
-        "/usr/local/lib/" n,                    \
-        "/usr/lib/" n
+        "/overlayer/syshub/lib/" n,                    \
+        "/overlayer/syshub/lib/" n
 
 #define CONF_PATHS_STRV(n)                      \
         STRV_MAKE(CONF_PATHS(n))
