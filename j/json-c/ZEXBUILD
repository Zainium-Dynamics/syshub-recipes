maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=json-c
pkgver=0.18
pkgrel=0
source="https://s3.amazonaws.com/json-c_releases/releases/json-c-$pkgver.tar.gz"
sha256sums="876ab046479166b869afc6896d288183bbc0e5843f141200c677b3e8dfb11724  json-c-$pkgver.tar.gz"
makedepends="cmake samurai"

build() {
    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_STATIC_LIBS=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_APPS=OFF
    cmake --build build
    DESTDIR="$(pwd)/_zexbuild-install" cmake --install build
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    # runtime only: headers, pkgconfig, static archives and docs stay out of the base
    rm -rf "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/share/man" \
        "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/gtk-doc" "$PAYLOAD_DIR/share/info"
    find "$PAYLOAD_DIR" \( -name '*.a' -o -name '*.la' \) -delete
}
