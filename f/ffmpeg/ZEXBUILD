maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=ffmpeg
pkgver=9.0.2
pkgrel=0
subpackages="ffmpeg-dev"
source="https://ffmpeg.org/releases/ffmpeg-$pkgver.tar.xz"
sha256sums="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e  ffmpeg-$pkgver.tar.xz"
makedepends="nasm pkgconf"
needs_toolchain="zlib zlib-dev dav1d dav1d-dev"

# LGPL only (no --enable-gpl / --enable-nonfree): the decoders GStreamer's libav plugin
# uses for H.264, H.265, AAC and the other common formats
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    # ffmpeg's configure ignores CFLAGS/LDFLAGS from the environment
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --shlibdir=/overlayer/syshub/lib \
        --extra-cflags="${CFLAGS:-}" \
        --extra-ldflags="${LDFLAGS:-}" \
        --enable-shared \
        --disable-static \
        --enable-pic \
        --disable-debug \
        --disable-doc \
        --disable-xlib \
        --disable-libxcb \
        --disable-sdl2 \
        --enable-zlib \
        --enable-libdav1d
    make
    make DESTDIR="$(pwd)/_zexbuild-install" install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib"
    cp -a "$inst"/bin/ffmpeg "$inst"/bin/ffprobe "$PAYLOAD_DIR/bin/"
    find "$inst/lib" -maxdepth 1 -name 'lib*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
