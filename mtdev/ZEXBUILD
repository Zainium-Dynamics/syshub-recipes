maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=mtdev
pkgver=1.1.7
pkgrel=0
subpackages="mtdev-dev"
source="https://bitmath.org/code/mtdev/mtdev-$pkgver.tar.bz2"
sha256sums="a107adad2101fecac54ac7f9f0e0a0dd155d954193da55c2340c97f2ff1d814e  mtdev-$pkgver.tar.bz2"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --enable-shared \
        --enable-static
    make -j"$(nproc)"
    make install DESTDIR="$(pwd)/_zexbuild-install"
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libmtdev.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp "$inst/lib/libmtdev.a" "$PAYLOAD_DIR/lib/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
