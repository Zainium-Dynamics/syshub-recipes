maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libevdev
pkgver=1.13.7
pkgrel=0
subpackages="libevdev-dev"
source="https://gitlab.freedesktop.org/libevdev/libevdev/-/archive/libevdev-$pkgver/libevdev-libevdev-$pkgver.tar.gz"
sha256sums="9294aaaff6829ab1581e6684f4c3ddc449fee563229e863353a4893f1a673f4b  libevdev-libevdev-$pkgver.tar.gz"
makedepends="meson ninja"

build() {
    cd "libevdev-libevdev-$pkgver"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        -Dtests=disabled \
        -Ddocumentation=disabled \
        -Dtools=enabled
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin"
    find "$inst/lib" -maxdepth 1 -name 'libevdev*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/touchpad-edge-detector" "$inst/bin/mouse-dpi-tool" "$inst/bin/libevdev-tweak-device" "$PAYLOAD_DIR/bin/"
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
