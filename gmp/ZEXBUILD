maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=gmp
pkgver=6.3.0
pkgrel=0
subpackages="gmp-dev"
source="https://ftp.gnu.org/gnu/gmp/gmp-$pkgver.tar.xz"
sha256sums="a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898  gmp-$pkgver.tar.xz"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --enable-shared \
        --disable-static
    make -j"$(nproc)"
}

package() {
    make install DESTDIR="$PAYLOAD_DIR"

    mkdir -p "$STAGING_ROOT/_gmp-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_gmp-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_gmp-dev/pkgconfig"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_gmp-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_gmp-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
