maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=gmp
pkgver=6.3.0
pkgrel=0
subpackages="gmp-dev"
source="https://ftp.gnu.org/gnu/gmp/gmp-$pkgver.tar.xz"
sha256sums="a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898  gmp-$pkgver.tar.xz"
needs_toolchain="musl gcc-musl"

# Alpine's own gcc fails GMP's own "long long reliability" self-test
# (compiled-and-executed probe) under every ABI/flag combo it tries,
# on this CI host -- switching to our own published gcc-musl-cross
# (same toolchain binutils/gcc-16 use) and telling configure this is a
# real --host cross-build skips that probe entirely (can't execute a
# zainium-target binary as part of ./configure on an Alpine build
# machine, so it falls back to GMP's own known-good ABI defaults).
build() {
    unset LDFLAGS
    local sysroot="/overlayer/syshub"
    local musl_sysroot="${sysroot}/x86_64-zainium-linux-musl"
    export CC="${sysroot}/bin/x86_64-zainium-linux-musl-gcc"
    export CPPFLAGS="-I${musl_sysroot}/include -I${sysroot}/include"
    export CFLAGS="-O2 ${CPPFLAGS}"
    export LDFLAGS="-L${musl_sysroot}/lib -L${sysroot}/lib"
    ./configure \
        --build="$(gcc -dumpmachine)" \
        --host=x86_64-zainium-linux-musl \
        --prefix="$sysroot" \
        --libdir="${sysroot}/lib" \
        --enable-shared \
        --disable-static
    make -j"$(nproc)"
}

package() {
    make install DESTDIR="$PAYLOAD_DIR"

    mkdir -p "$STAGING_ROOT/_gmp-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_gmp-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_gmp-dev/pkgconfig"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_gmp-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_gmp-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
