maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libgudev
pkgver=238
pkgrel=0
subpackages="$pkgname-dev"
source="https://download.gnome.org/sources/libgudev/$pkgver/libgudev-$pkgver.tar.xz"
sha256sums="61266ab1afc9d73dbc60a8b2af73e99d2fdff47d99544d085760e4fa667b5dd1  libgudev-$pkgver.tar.xz"
makedepends="meson ninja pkgconf glib-dev"
# links the base's own libudev (systemd)
needs_toolchain="systemd systemd-dev"

build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        -Dtests=disabled \
        -Dintrospection=disabled \
        -Dvapi=disabled \
        -Dgtk_doc=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="$SRCDIR/libgudev-$pkgver/_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libgudev-1.0.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    [ -e "$PAYLOAD_DIR/lib/libgudev-1.0.so.0" ]
}

dev() {
    local inst="$SRCDIR/libgudev-$pkgver/_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
