maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libmnl
pkgver=1.0.5
pkgrel=0
source="https://www.netfilter.org/pub/libmnl/libmnl-$pkgver.tar.bz2"
sha256sums="274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525  libmnl-$pkgver.tar.bz2"
makedepends="pkgconf linux-headers"

# Small netlink library; libnftnl and nft are built on it. 1.0.5 is the latest release.
build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    cp -P "$inst"/lib/libmnl.so.* "$PAYLOAD_DIR/lib/"
}
