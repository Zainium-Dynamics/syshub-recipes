maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libtiff
pkgver=4.7.0
pkgrel=0
subpackages="libtiff-dev"
# tarball unpacks to tiff-$pkgver/, not $pkgname-$pkgver/, so build() cd's itself
source="https://download.osgeo.org/libtiff/tiff-$pkgver.tar.gz"
sha256sums="67160e3457365ab96c5b3286a0903aa6e78bdc44c4bc737d2e486bcecb6ba976  tiff-$pkgver.tar.gz"
needs_toolchain="zlib zlib-dev libjpeg-turbo libjpeg-turbo-dev"
makedepends="pkgconf"

build() {
    cd "tiff-$pkgver"
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ./configure \
        --prefix=/overlayer/syshub \
        --disable-static \
        --disable-tests \
        --disable-contrib \
        --disable-webp \
        --disable-zstd \
        --disable-lzma \
        --disable-jbig \
        --disable-lerc
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="tiff-$pkgver/_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 \( -name 'libtiff.so*' -o -name 'libtiffxx.so*' \) -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="tiff-$pkgver/_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
