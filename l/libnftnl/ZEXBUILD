maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libnftnl
pkgver=1.3.2
pkgrel=0
source="https://www.netfilter.org/pub/libnftnl/libnftnl-$pkgver.tar.xz"
sha256sums="c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0  libnftnl-$pkgver.tar.xz"
makedepends="pkgconf libmnl-dev linux-headers"

build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --disable-static
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    cp -P "$inst"/lib/libnftnl.so.* "$PAYLOAD_DIR/lib/"
}
