maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libndp
pkgver=1.9
pkgrel=0
subpackages="libndp-dev"
source="https://github.com/jpirko/libndp/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="e564f5914a6b1b799c3afa64c258824a801c1b79a29e2fe6525b682249c65261  v$pkgver.tar.gz"
makedepends="autoconf automake libtool pkgconf"

build() {
    ./autogen.sh
    CFLAGS="-Wno-error=incompatible-pointer-types" ./configure \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --enable-shared \
        --disable-static
    make -j"$(nproc)"
}

package() {
    make install DESTDIR="$PAYLOAD_DIR"

    mkdir -p "$STAGING_ROOT/_libndp-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_libndp-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_libndp-dev/pkgconfig"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_libndp-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_libndp-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
