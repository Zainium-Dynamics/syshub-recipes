maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libXft
pkgver=2.3.8
pkgrel=0
subpackages="libXft-dev"
source="https://xorg.freedesktop.org/archive/individual/lib/libXft-2.3.8.tar.xz"
sha256sums="5e8c3c4bc2d4c0a40aef6b4b38ed2fb74301640da29f6528154b5009b1c6dd49  libXft-$pkgver.tar.xz"
# X.Org release tarball ships a generated configure, so no util-macros/autoreconf.
needs_toolchain="gcc-musl xorgproto libxcb libxcb-dev libXau libXau-dev libXdmcp libXdmcp-dev libX11 libX11-dev libXrender libXrender-dev freetype freetype-dev fontconfig fontconfig-dev"
makedepends="pkgconf"

build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig:/overlayer/zexlib/union/lib/pkgconfig:/overlayer/zexlib/union/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --disable-static
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'lib*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    :
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
