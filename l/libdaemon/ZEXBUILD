maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libdaemon
pkgver=0.14
pkgrel=0
subpackages="libdaemon-dev"
source="https://0pointer.de/lennart/projects/libdaemon/libdaemon-$pkgver.tar.gz"
sha256sums="fd23eb5f6f986dcc7e708307355ba3289abe03cc381fc47a80bca4a50aa6b834  libdaemon-$pkgver.tar.gz"
makedepends="pkgconf"

# Lightweight C library for writing UNIX daemons; a build dependency of avahi.
build() {
    # the forkbomb/daemonize self-test can't run in a sandboxed build host
    ac_cv_func_setpgrp_void=yes ./configure \
        --prefix=/overlayer/syshub \
        --localstatedir=/overlayer/syshub/var \
        --disable-static \
        --disable-lynx \
        --disable-examples
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libdaemon.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
