maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=libexif
pkgver=0.6.25
pkgrel=0
subpackages="libexif-dev"
source="https://github.com/libexif/libexif/releases/download/v$pkgver/libexif-$pkgver.tar.xz"
sha256sums="62f74cf3bf673a6e24d2de68f6741643718541f83aca5947e76e3978c25dce83  libexif-$pkgver.tar.xz"
makedepends="pkgconf"

# EXIF metadata parsing, used by the cups-filters image filters.
build() {
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --disable-static \
        --disable-nls \
        --disable-docs
    make
    DESTDIR="$(pwd)/_zexbuild-install" make install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libexif.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    :
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
