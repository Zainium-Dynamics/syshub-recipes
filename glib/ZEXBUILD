maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=glib
pkgver=2.89.3
pkgrel=1
subpackages="glib-dev"
source="https://download.gnome.org/sources/glib/2.89/glib-$pkgver.tar.xz"
sha256sums="09fd1e99f991067749ad66090e482ec4bd6514ad53abb4e9fbbdc2a4d2753532  glib-$pkgver.tar.xz"
makedepends="libffi-dev pcre2-dev zlib-dev"

build() {
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        -Ddefault_library=shared \
        -Dman-pages=disabled \
        -Ddocumentation=false \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Dintrospection=disabled \
        -Dnls=disabled \
        -Dlibmount=disabled \
        -Dselinux=disabled \
        -Dxattr=false \
        -Dlibelf=disabled \
        -Dsysprof=disabled \
        -Ddtrace=disabled \
        -Dsystemtap=disabled \
        -Doss_fuzz=disabled \
        -Dmultiarch=false
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    find "$inst/lib" -maxdepth 1 -name '*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst"/lib/gio "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/"
    cp -a "$inst/share/glib-2.0" "$PAYLOAD_DIR/share/" 2>/dev/null || true
    rm -f "$PAYLOAD_DIR"/bin/glib-genmarshal "$PAYLOAD_DIR"/bin/glib-mkenums "$PAYLOAD_DIR"/bin/gtester-report
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/bin"
    mkdir -p "$PAYLOAD_DIR/lib/glib-2.0"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
    cp -a "$inst"/lib/glib-2.0/include "$PAYLOAD_DIR/lib/glib-2.0/"
    for tool in glib-genmarshal glib-mkenums gtester-report; do
        cp "$inst/bin/$tool" "$PAYLOAD_DIR/bin/" 2>/dev/null || true
    done
}
