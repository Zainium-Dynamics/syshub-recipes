maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=tzdata
pkgver=2026c
pkgrel=0
source="https://data.iana.org/time-zones/releases/tzdata$pkgver.tar.gz https://data.iana.org/time-zones/releases/tzcode$pkgver.tar.gz"
sha256sums="e4a178a4477f3d0ea77cc31828ff72aa38feff8d61aa13e7e99e142e9d902be4  tzdata$pkgver.tar.gz
b1cffc3ace4c4c7cd0efba2f7add86ec3d0b79da48bcf03582671fd3c8feace8  tzcode$pkgver.tar.gz"

# tzdata is just data -- zic never ships, it only has to run once on the
# build host to compile the raw zone files into the binary TZif format.
# tzcode is pulled in purely as a build-time tool for that (bundled per
# IANA's own "extract both tarballs, build together" convention), not
# as a runtime dependency -- the real zic/zdump ship separately as the
# tzcode package.
build() {
    make -C "tzcode$pkgver" zic
    zic="$(pwd)/tzcode$pkgver/zic"

    cd "tzdata$pkgver"
    mkdir -p zoneinfo
    "$zic" -d zoneinfo -b fat africa antarctica asia australasia europe \
        northamerica southamerica etcetera backward
}

package() {
    mkdir -p "$PAYLOAD_DIR/share/zoneinfo"
    cp -a zoneinfo/. "$PAYLOAD_DIR/share/zoneinfo/"
    cp iso3166.tab zone1970.tab leapseconds "$PAYLOAD_DIR/share/zoneinfo/"
}
