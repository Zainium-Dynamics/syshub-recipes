maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=curl
pkgver=8.22.0
pkgrel=0
subpackages="curl-dev"
source="https://github.com/curl/curl/releases/download/curl-8_22_0/curl-$pkgver.tar.gz"
sha256sums="d54dd598bf05927a726deb38df31c6a255ba83ff1de57c5d1464dac3ed8f44a1  curl-$pkgver.tar.gz"
makedepends="cmake"
needs_toolchain="openssl openssl-dev zlib zlib-dev zstd zstd-dev"

build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    cmake -B builddir -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_CURL_EXE=ON \
        -DCURL_USE_OPENSSL=ON \
        -DCURL_ZLIB=ON \
        -DCURL_BROTLI=OFF \
        -DCURL_ZSTD=ON \
        -DUSE_NGHTTP2=OFF \
        -DCURL_USE_LIBPSL=OFF \
        -DUSE_LIBIDN2=OFF \
        -DENABLE_ARES=OFF \
        -DCURL_DISABLE_LDAP=ON \
        -DCURL_CA_BUNDLE=/overlayer/syshub/etc/ssl/certs/ca-certificates.crt \
        -DCURL_CA_PATH=/overlayer/syshub/etc/ssl
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin"
    find "$inst/lib" -maxdepth 1 -name 'libcurl.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/bin/curl" "$PAYLOAD_DIR/bin/"
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
}
