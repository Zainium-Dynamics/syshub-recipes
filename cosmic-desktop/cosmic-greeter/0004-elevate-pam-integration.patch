+impl elevate_pam::conv::Converser for Conversation {
+    fn converse(
+        &mut self,
+        messages: &[elevate_pam::types::Message],
+    ) -> elevate_pam::error::PamResult<Vec<elevate_pam::types::Response>> {
+        use elevate_pam::error::{PamError, PamStatus};
+        use elevate_pam::types::{MsgStyle, Response};
+
+        let mut out = Vec::with_capacity(messages.len());
+        for m in messages {
+            tracing::info!("{:?} {:?}", m.style, m.text);
+            match m.style {
+                MsgStyle::PromptEchoOn => {
+                    let text = self
+                        .prompt_value(&m.text, false)
+                        .map_err(|()| PamError::Status(PamStatus::new(19)))?;
+                    out.push(Response { text, retcode: 0 });
+                }
+                MsgStyle::PromptEchoOff => {
+                    let text = self
+                        .prompt_value(&m.text, true)
+                        .map_err(|()| PamError::Status(PamStatus::new(19)))?;
+                    out.push(Response { text, retcode: 0 });
+                }
+                MsgStyle::TextInfo => {
+                    if self.message(&m.text).is_err() {
+                        tracing::warn!("failed to send text_info");
+                    }
+                    out.push(Response {
+                        text: String::new(),
+                        retcode: 0,
+                    });
+                }
+                MsgStyle::ErrorMsg => {
+                    if self.error_message(&m.text).is_err() {
+                        tracing::warn!("failed to send error_msg");
+                    }
+                    out.push(Response {
+                        text: String::new(),
+                        retcode: 0,
+                    });
+                }
+                _ => out.push(Response {
+                    text: String::new(),
+                    retcode: 0,
+                }),
             }
         }
+        Ok(out)
