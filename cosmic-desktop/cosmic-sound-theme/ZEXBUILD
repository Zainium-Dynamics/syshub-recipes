makedepends="meson"

build() {
	cd cosmic-sound-theme-epoch-$pkgver
	meson setup output --prefix=/overlayer/syshub
	meson compile -C output
}

package() {
	DESTDIR="$PAYLOAD_DIR" meson install --no-rebuild -C output
}
