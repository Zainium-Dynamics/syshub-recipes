diff -ruN '--exclude=.git' '--exclude=target' a/src/env_resolver.rs b/src/env_resolver.rs
--- a/src/env_resolver.rs	1970-01-01 05:00:00.000000000 +0500
+++ b/src/env_resolver.rs	2026-08-26 16:17:59.380945418 +0500
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+fn oxienv_dir() -> PathBuf {
+    if let Ok(over) = std::env::var(oxidized_environment::ROOT_OVERRIDE_ENV) {
+        return PathBuf::from(over);
+    }
+    let zainium = Path::new("/overlayer/syshub");
+    if zainium.is_dir() {
+        zainium.join("etc")
+    } else {
+        PathBuf::from("/etc")
+    }
+}
+
+pub fn resolve() -> HashMap<String, String> {
+    oxidized_environment::resolve(&oxienv_dir())
+}
+
+const PATH_LIST_VARS: &[&str] = &[
+    "PATH",
+    "LD_LIBRARY_PATH",
+    "XDG_DATA_DIRS",
+    "PKG_CONFIG_PATH",
+];
+
+pub fn resolve_merged() -> HashMap<String, String> {
+    let mut merged = resolve();
+    for key in PATH_LIST_VARS {
+        let Some(resolved) = merged.get(*key).cloned() else {
+            continue;
+        };
+        let mut parts: Vec<&str> = resolved.split(':').filter(|s| !s.is_empty()).collect();
+        let existing = std::env::var(key).unwrap_or_default();
+        for part in existing.split(':') {
+            if !part.is_empty() && !parts.contains(&part) {
+                parts.push(part);
+            }
+        }
+        merged.insert((*key).to_string(), parts.join(":"));
+    }
+    merged
+}
