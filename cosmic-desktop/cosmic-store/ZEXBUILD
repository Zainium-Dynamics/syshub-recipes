maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=cosmic-store
pkgver=1.10.0
pkgrel=4
source="https://github.com/pop-os/cosmic-store/archive/refs/tags/epoch-$pkgver.tar.gz
0001-appstream-zainium-paths.patch
0002-system-remote-appstream-update.patch
0003-first-catalog-status.patch
0004-background-appstream-refresh.patch"
makedepends="rustup just pkgconf cmake flatpak-dev glib-dev libxkbcommon-dev wayland-dev"

# Upstream default features: flatpak is the only backend compiled in.
build() {
    cd cosmic-store-epoch-$pkgver

    # appstream catalogs: share from syshub and the union, var/lib and var/cache from the union
    patch -p1 < ../0001-appstream-zainium-paths.patch
    # system remotes were refreshed by display id "flathub (system)", which flatpak doesn't know
    patch -p1 < ../0002-system-remote-appstream-update.patch
    # first Flathub catalog: retry network hiccups, say it is downloading, and say when it failed
    patch -p1 < ../0003-first-catalog-status.patch
    # an existing catalog shows at once; the hourly refresh runs in the background for next start
    patch -p1 < ../0004-background-appstream-refresh.patch

    # Alpine's cargo has no x86_64-unknown-linux-musl std, so take nightly from rustup
    export LD_LIBRARY_PATH=/usr/lib:/lib
    rustup-init -y -q --default-toolchain none --profile minimal
    export PATH="$HOME/.cargo/bin:$PATH"
    rustup toolchain install nightly --profile minimal --target x86_64-unknown-linux-musl
    export RUSTUP_TOOLCHAIN=nightly
    # dynamic, against the Alpine -dev libs at build time and the syshub ones at run time
    # other recipes in the same CI job leave Zainium libraries in /overlayer/syshub; link only
    # against Alpine's, so libflatpak's own needs (versioned libxml2) resolve from /usr/lib
    export PKG_CONFIG_PATH=/usr/lib/pkgconfig:/usr/share/pkgconfig
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="${CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS:-} -C target-feature=-crt-static -C relocation-model=dynamic-no-pic -C link-arg=-Wl,-rpath-link,/usr/lib"
    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install
}
