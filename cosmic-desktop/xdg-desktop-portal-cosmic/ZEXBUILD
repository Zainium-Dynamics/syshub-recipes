maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=xdg-desktop-portal-cosmic
pkgver=1.11.0
pkgrel=0
source="https://github.com/pop-os/xdg-desktop-portal-cosmic/archive/refs/tags/epoch-$pkgver.tar.gz
0002-overlayer-syshub-path.patch
0003-widget-screenshot-syshub-path.patch"
sha256sums="5befa4beda6ee231ebaa553b3db53d794500b5646de385fd1f576a7406242f16  epoch-$pkgver.tar.gz"
makedepends="rustup just pkgconf eudev-dev libinput-dev libxkbcommon-dev wayland-dev glib-dev dbus-dev pipewire-dev mesa-dev clang-libclang"

build() {
    cd xdg-desktop-portal-cosmic-epoch-$pkgver

    patch -p1 < ../0002-overlayer-syshub-path.patch
    patch -p1 < ../0003-widget-screenshot-syshub-path.patch

    export LIBCLANG_PATH="$(dirname "$(find /usr/lib -name 'libclang.so*' | head -1)")"
    mkdir -p .cargo
    cat > .cargo/config.toml <<-'EOF'
	[host]
	rustflags = ["-C", "target-feature=-crt-static"]
	EOF

    # Alpine's cargo has no x86_64-unknown-linux-musl std; stable wins over rust-toolchain.toml
    export LD_LIBRARY_PATH=/usr/lib:/lib
    rustup-init -y -q --default-toolchain none --profile minimal
    export PATH="$HOME/.cargo/bin:$PATH"
    rustup toolchain install stable --profile minimal --target x86_64-unknown-linux-musl
    export RUSTUP_TOOLCHAIN=stable
    # dynamic, against the Alpine -dev libs at build time and the syshub ones at run time
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="${CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS:-} -C target-feature=-crt-static -C relocation-model=dynamic-no-pic"
    export VERGEN_GIT_COMMIT_DATE="$(date -u '+%Y-%m-%d')"
    export VERGEN_GIT_SHA="unknown"
  
    cargo build -Z host-config -Z target-applies-to-host \
        --release --target x86_64-unknown-linux-musl
}

package() {
    just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
        cargo-target-dir=target/x86_64-unknown-linux-musl install

}
