maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cosmic-idle
pkgver=1.11.0
pkgrel=0
source="https://github.com/pop-os/cosmic-idle/archive/refs/tags/epoch-$pkgver.tar.gz
0001-shell-spawn-syshub-path.patch"
sha256sums="683290f2a67a63fd553f654a34756cbfdcc41b2d2141b79850c58c16643dc63a  epoch-$pkgver.tar.gz"
makedepends="rustup just pkgconf eudev-dev libinput-dev libxkbcommon-dev wayland-dev"

build() {
	cd cosmic-idle-epoch-$pkgver
	# run_command() (idle-timeout system actions) spawned via a hardcoded
	# /bin/sh -- doesn't exist on Zainium, only /overlayer/syshub/bin/sh does.
	patch -p1 < ../0001-shell-spawn-syshub-path.patch
	    # Alpine's cargo has no x86_64-unknown-linux-musl std; stable wins over rust-toolchain.toml
    export LD_LIBRARY_PATH=/usr/lib:/lib
    rustup-init -y -q --default-toolchain none --profile minimal
    export PATH="$HOME/.cargo/bin:$PATH"
    rustup toolchain install stable --profile minimal --target x86_64-unknown-linux-musl
    export RUSTUP_TOOLCHAIN=stable
    # dynamic, against the Alpine -dev libs at build time and the syshub ones at run time
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="${CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS:-} -C target-feature=-crt-static -C relocation-model=dynamic-no-pic"
    export VERGEN_GIT_COMMIT_DATE="$(date -u '+%Y-%m-%d')"
    export VERGEN_GIT_SHA="unknown"
cargo build --release --target x86_64-unknown-linux-musl
}

package() {
	just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub \
		cargo-target-dir=target/x86_64-unknown-linux-musl install
}
