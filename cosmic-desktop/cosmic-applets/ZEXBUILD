maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=cosmic-applets
pkgver=1.11.0
pkgrel=0
source="https://github.com/pop-os/cosmic-applets/archive/refs/tags/epoch-$pkgver.tar.gz"
sha256sums="d2ad09b72a2dcba2a17f12e557f0e21dc60171eefa54390e4b67bb058f9180e2  epoch-$pkgver.tar.gz"
makedepends="rustup just pkgconf findutils util-linux-misc dbus-dev eudev-dev libinput-dev libxkbcommon-dev wayland-dev"

# the justfile installs icons with GNU xargs -d and rev, which BusyBox lacks
build() {
    cd cosmic-applets-epoch-$pkgver
    # Alpine's cargo has no x86_64-unknown-linux-musl std; stable wins over rust-toolchain.toml
    # (nightly hits a zbus async-drop query cycle)
    export LD_LIBRARY_PATH=/usr/lib:/lib
    rustup-init -y -q --default-toolchain none --profile minimal
    export PATH="$HOME/.cargo/bin:$PATH"
    rustup toolchain install stable --profile minimal --target x86_64-unknown-linux-musl
    export RUSTUP_TOOLCHAIN=stable
    # dynamic, against the Alpine -dev libs at build time and the syshub ones at run time
    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="${CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS:-} -C target-feature=-crt-static -C relocation-model=dynamic-no-pic"
    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    # still in the source dir build() changed into; the justfile reads CARGO_TARGET_DIR
    CARGO_TARGET_DIR=target/x86_64-unknown-linux-musl \
        just rootdir="$PAYLOAD_DIR" prefix=/overlayer/syshub install
}
