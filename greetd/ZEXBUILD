maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=greetd
pkgver=0.10.3
pkgrel=0

source="https://github.com/Zainium-Dynamics/greetd/archive/refs/tags/v$pkgver.tar.gz"
sha256sums="5a62e840a519a5f994150f2f1ccd95295ff413c3f88b78e5a2886001b2db17ec  v$pkgver.tar.gz"
makedepends="cargo"
depends="elevate-privilege"

build() {
    unset LDFLAGS
    cargo build --release --workspace
}

package() {
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/etc/pam.d" \
        "$PAYLOAD_DIR/etc/greetd" "$PAYLOAD_DIR/lib/systemd/system" "$PAYLOAD_DIR/lib/sysusers.d"

    cp target/release/greetd "$PAYLOAD_DIR/bin/greetd"
    cp target/release/agreety "$PAYLOAD_DIR/bin/agreety"
    strip "$PAYLOAD_DIR/bin/"*

    cat > "$PAYLOAD_DIR/etc/pam.d/greetd" <<'EOF'
auth       required     pam_unix.so nullok
auth       required     pam_env.so
account    required     pam_unix.so
account    required     pam_nologin.so
password   required     pam_unix.so nullok
session    required     pam_unix.so
session    required     pam_env.so
EOF

   
    cat > "$PAYLOAD_DIR/etc/greetd/config.toml" <<'EOF'
[terminal]
vt = "1"
[default_session]
command = "cosmic-greeter-start"
user = "cosmic-greeter"
EOF

    cat > "$PAYLOAD_DIR/lib/systemd/system/greetd.service" <<'EOF'
[Unit]
Description=Greeter daemon
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty1.service
Conflicts=getty@tty1.service
Before=graphical.target

[Service]
Type=simple
ExecStart=/overlayer/syshub/bin/greetd
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
WantedBy=graphical.target
Alias=display-manager.service
EOF

    cat > "$PAYLOAD_DIR/lib/sysusers.d/greetd.conf" <<'EOF'
u greeter - "greetd greeter" -
EOF

  
    chmod 644 "$PAYLOAD_DIR/lib/systemd/system/greetd.service"
}
