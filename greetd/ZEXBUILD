maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=greetd
pkgver=0.10.3
pkgrel=0
source="https://github.com/kennylevinsen/greetd/archive/refs/tags/$pkgver.tar.gz"
sha256sums="ee5cb70e0add4ca9c9fe57e47581ab0002d44c07743fb5492469f3b570db640b  $pkgver.tar.gz"
makedepends="cargo"

# greetd's own auth path (pam-sys crate) hard-depends on PAM -- not
# optional, no feature flag. Real PAM is elevate-privilege's own
# elevate-pam (libpam.so.0 + lib/security/*.so) -- deployed separately,
# not built or bundled here. Do not reintroduce Alpine's borrowed
# glibc linux-pam-dev/.so -- that was here once, deliberately removed.
build() {
    # RUSTFLAGS below applies to every rustc invocation, including cargo's
    # own build-script helper binaries that run right here on the CI host
    # -- they inherit the /overlayer/syshub/lib RPATH too and need a real
    # libgcc_s.so.1 to find there, same musl-ABI-stable-borrow reasoning
    # as the /usr bootstrap list in ci/build.sh itself.
    mkdir -p /overlayer/syshub/lib
    [ -e /overlayer/syshub/lib/libgcc_s.so.1 ] || cp -L /usr/lib/libgcc_s.so.1 /overlayer/syshub/lib/libgcc_s.so.1

    export RUSTFLAGS="-C link-arg=-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -C link-arg=-Wl,-rpath=/overlayer/syshub/lib"
    cargo build --release --workspace
}

package() {
    mkdir -p "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/lib/security" "$PAYLOAD_DIR/etc/pam.d" \
        "$PAYLOAD_DIR/etc/greetd" "$PAYLOAD_DIR/lib/systemd/system" "$PAYLOAD_DIR/lib/sysusers.d"

    cp target/release/greetd "$PAYLOAD_DIR/bin/greetd"
    cp target/release/agreety "$PAYLOAD_DIR/bin/agreety"
    strip "$PAYLOAD_DIR/bin/"*

    cat > "$PAYLOAD_DIR/etc/pam.d/greetd" <<'EOF'
auth       required     pam_unix.so nullok
auth       required     pam_env.so
account    required     pam_unix.so
account    required     pam_nologin.so
password   required     pam_unix.so nullok
session    required     pam_unix.so
session    required     pam_env.so
EOF

    # cosmic-greeter, not agreety+bash -- Zainium's actual default
    # session is the COSMIC greeter UI, not a bare shell. Shipping the
    # generic upstream default here would silently clobber this on
    # every rebuild (this exact file was hand-authored/renamed once
    # already at etc/greetd/config.toml in zairoot -- see
    # cosmic-greeter's own sysusers.d entry for the matching user).
    cat > "$PAYLOAD_DIR/etc/greetd/config.toml" <<'EOF'
[terminal]
vt = "1"

[general]
service = "cosmic-greeter"

[default_session]
command = "cosmic-greeter-start"
user = "cosmic-greeter"
EOF

    cat > "$PAYLOAD_DIR/lib/systemd/system/greetd.service" <<'EOF'
[Unit]
Description=Greeter daemon
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty1.service
Conflicts=getty@tty1.service
Before=graphical.target

[Service]
Type=simple
ExecStart=/overlayer/syshub/bin/greetd
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
WantedBy=graphical.target
Alias=display-manager.service
EOF

    cat > "$PAYLOAD_DIR/lib/sysusers.d/greetd.conf" <<'EOF'
u greeter - "greetd greeter" -
EOF

    # unit files are data, not programs -- "Configuration file X is
    # marked executable" warning at every boot otherwise (same bug
    # class already hit and fixed for systemd's own units, 2026-09-04).
    chmod 644 "$PAYLOAD_DIR/lib/systemd/system/greetd.service"
}
