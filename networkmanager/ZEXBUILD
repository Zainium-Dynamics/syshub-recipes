maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=networkmanager
pkgver=1.58.1
pkgrel=5
subpackages="networkmanager-dev"
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/1.58.1/NetworkManager-$pkgver.tar.gz"
sha256sums="8d112eefc0e0e15d44e93453a8a16760ec07a4037e1f93097abdf55abd5dca2d  NetworkManager-$pkgver.tar.gz"
makedepends="meson ninja pkgconf glib-dev dbus-dev libndp-dev util-linux-dev curl-dev libpsl-dev readline-dev gnutls-dev bluez-dev eudev-dev"
needs_toolchain="systemd systemd-dev dbus dbus-dev util-linux"

build() {
    cd "NetworkManager-$pkgver"
    # resolv.conf lives in Zainium's etc, where musl reads it: <resolv.h>'s _PATH_RESCONF
    # and NetworkManager's temp file both say /etc, which Zainium doesn't have
    printf '%s\n' '#include <resolv.h>' '#undef _PATH_RESCONF' \
        '#define _PATH_RESCONF "/overlayer/syshub/etc/resolv.conf"' > src/core/dns/zainium-resolv.h
    sed -i -e 's|^#include <resolv.h>$|#include "zainium-resolv.h"|' \
        -e 's|"/etc/\.resolv\.conf\.NetworkManager"|"/overlayer/syshub/etc/.resolv.conf.NetworkManager"|' \
        src/core/dns/nm-dns-manager.c
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        --libdir=/overlayer/syshub/lib \
        -Dsystemd_journal=true \
        -Dsystemdsystemunitdir=/overlayer/syshub/lib/systemd/system \
        -Dsystemdsystemgeneratordir=/overlayer/syshub/lib/systemd/system-generators \
        -Ddbus_conf_dir=/overlayer/syshub/etc/dbus-1/system.d \
        -Dcrypto=gnutls \
        -Dselinux=false \
        -Dclat=false \
        -Dlibaudit=no \
        -Dpolkit=false \
        -Dpolkit_noauth_group=wheel \
        -Dmodify_system=false \
        -Dsession_tracking=systemd \
        -Dsuspend_resume=systemd \
        -Diwd=true \
        -Dwext=false \
        -Dwifi=true \
        -Dconfig_wifi_backend_default=iwd \
        -Ddhcpcd=false \
        -Dppp=false \
        -Dmodem_manager=false \
        -Dbluez5_dun=true \
        -Dteamdctl=false \
        -Dovs=false \
        -Dnm_cloud_setup=false \
        -Dqt=false \
        -Dnmtui=false \
        -Dnmcli=true \
        -Dnbft=false \
        -Dintrospection=false \
        -Dvapi=false \
        -Ddocs=false \
        -Dman=false \
        -Dtests=no
    ninja -C builddir
}

package() {
    DESTDIR="$PAYLOAD_DIR" ninja -C builddir install

    is_text_file() {
        case "$(file -b --mime-type "$1")" in
            text/*) return 0 ;;
            *) return 1 ;;
        esac
    }

    for f in $(grep -rIl "/usr/" "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i \
            -e 's#/usr/lib/#/overlayer/syshub/lib/#g' \
            -e 's#/usr/sbin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/bin/#/overlayer/syshub/bin/#g' \
            -e 's#/usr/share/#/overlayer/syshub/share/#g' \
            -e 's#/usr/#/overlayer/syshub/#g' \
            "$f"
    done

    for f in $(grep -rIl '/var/' "$PAYLOAD_DIR" 2>/dev/null); do
        is_text_file "$f" || continue
        sed -i 's#/var/#/overlayer/syshub/var/#g' "$f"
    done

    # ProtectSystem=true/full makes systemd mount /usr read-only and fails the whole unit
    # (226/NAMESPACE) when /usr doesn't exist, as on Zainium
    find "$PAYLOAD_DIR" -name '*.service' -exec sed -i \
        -e 's#/usr/lib/#/overlayer/syshub/lib/#g' \
        -e 's#/usr/bin/#/overlayer/syshub/bin/#g' \
        -e 's#/usr/sbin/#/overlayer/syshub/bin/#g' \
        -e 's#/usr/#/overlayer/syshub/#g' \
        -e 's#^ProtectSystem=true$#ProtectSystem=false#' \
        -e 's#^ProtectSystem=full$#ProtectSystem=false#' \
        {} +

    # Zainium's tested config: keyfile connections under the Zainium etc, and
    # NetworkManager enabled by default (the base has no other network service)
    local sh="$PAYLOAD_DIR/overlayer/syshub"
    mkdir -p "$sh/etc/NetworkManager" "$sh/etc/systemd/system/multi-user.target.wants"
    cat > "$sh/etc/NetworkManager/NetworkManager.conf" <<'EOF'
[main]
plugins=keyfile

[keyfile]
path=/overlayer/syshub/etc/NetworkManager/system-connections
EOF
    ln -sf /overlayer/syshub/lib/systemd/system/NetworkManager.service \
        "$sh/etc/systemd/system/multi-user.target.wants/NetworkManager.service"

    # Zainium boots through quantra-ramfs, not a systemd initrd: the initrd units can
    # never start, and their generator only masks them on every boot
    rm -f "$sh"/lib/systemd/system/NetworkManager-config-initrd.service \
        "$sh"/lib/systemd/system/NetworkManager-initrd.service \
        "$sh"/lib/systemd/system/NetworkManager-wait-online-initrd.service \
        "$sh"/lib/systemd/system-generators/nm-initrd-generator.sh
    rmdir "$sh"/lib/systemd/system-generators 2>/dev/null || true
    # no /bin or /etc on Zainium
    for f in $(grep -rIlE '/bin/sh|/etc/' "$sh"/lib/udev "$sh"/lib/systemd "$sh"/share/dbus-1 2>/dev/null); do
        sed -i -e 's#\([^a-z/]\)/bin/sh #\1/overlayer/syshub/bin/sh #g' \
            -e 's#\([^a-z/]\)/etc/#\1/overlayer/syshub/etc/#g' "$f"
    done
    sed -i '\|^#ExecReload=/bin/kill|d' "$sh"/lib/systemd/system/NetworkManager.service

    mkdir -p "$STAGING_ROOT/_networkmanager-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_networkmanager-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_networkmanager-dev/pkgconfig"
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_networkmanager-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_networkmanager-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
