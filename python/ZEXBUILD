maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=python
pkgver=3.14.8
pkgrel=1
subpackages="$pkgname-dev"
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz"
sha256sums="c2215904f02b175596dc49351585104f4bc20341e1c47378b26a2c274360ce73  Python-$pkgver.tar.xz"
# Zainium has no util-linux-dev (libuuid headers) yet; everything else builds against Zainium's own packages
makedepends="linux-headers util-linux-dev"
needs_toolchain="bzip2 bzip2-dev expat expat-dev libffi libffi-dev ncurses ncurses-dev readline readline-dev
    sqlite sqlite-dev xz xz-dev zlib zlib-dev gettext gettext-dev openssl openssl-dev"

build() {
    cd "$SRCDIR/Python-$pkgver"
    rm -r Modules/expat
    patch -p1 < "$RECIPE_DIR/0001-musl-find_library-zainium-paths.patch"
    # subprocess shell, PATH fallback, os-release, mime.types and the REPL's terminfo under /overlayer
    patch -p1 < "$RECIPE_DIR/0002-zainium-paths.patch"

    # OpenSSL 4 dropped SSLv3_method and TLSv1_method, TLSv1_1_method, TLSv1_2_method without defining their OPENSSL_NO_* guards
    export CFLAGS_NODIST="${CFLAGS:-} -DTHREAD_STACK_SIZE=0x200000 -DOPENSSL_NO_SSL3_METHOD -DOPENSSL_NO_TLS1_METHOD -DOPENSSL_NO_TLS1_1_METHOD -DOPENSSL_NO_TLS1_2_METHOD"
    export LDFLAGS_NODIST="${LDFLAGS:-} -Wl,-z,stack-size=8388608"
    export LD_LIBRARY_PATH="/usr/lib:/lib"
    # the toolchain packages' headers, libraries and .pc files are under /overlayer/syshub
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export CPPFLAGS="-I/overlayer/syshub/include ${CPPFLAGS:-}"
    export LDFLAGS="-L/overlayer/syshub/lib ${LDFLAGS:-}"
    # the base has no libmpdec (bundled copy is used) and its ncurses ships no libpanelw
    ./configure \
        --prefix=/overlayer/syshub \
        --sysconfdir=/overlayer/syshub/etc \
        --mandir=/overlayer/syshub/share/man \
        --infodir=/overlayer/syshub/share/info \
        --localstatedir=/overlayer/syshub/var \
        --enable-ipv6 \
        --enable-loadable-sqlite-extensions \
        --enable-shared \
        --with-computed-gotos \
        --with-system-expat \
        --with-system-libmpdec=no \
        --with-openssl=/overlayer/syshub \
        --with-tzpath=/overlayer/syshub/share/zoneinfo \
        --without-ensurepip \
        py_cv_module__curses_panel=n/a
    make -j"$(nproc)"
}

package() {
    cd "$SRCDIR/Python-$pkgver"
    make -j1 DESTDIR="$PAYLOAD_DIR" install maninstall
    local p="$PAYLOAD_DIR/overlayer/syshub"
    ln -sf python3 "$p/bin/python"
    ln -sf python3-config "$p/bin/python-config"

    rm -rf "$p/lib/python3.14/test" \
        "$p/lib/python3.14/idlelib" \
        "$p/lib/python3.14/turtledemo" \
        "$p/lib/python3.14/ensurepip/_bundled"

    sed -i \
        -e 's#PEM_HEADER = "-----BEGIN CERTIFICATE-----"#PEM_HEADER = "-" * 5 + "BEGIN CERTIFICATE" + "-" * 5#' \
        -e 's#PEM_FOOTER = "-----END CERTIFICATE-----"#PEM_FOOTER = "-" * 5 + "END CERTIFICATE" + "-" * 5#' \
        "$p/lib/python3.14/ssl.py"
    sed -i "s#passwd='geheim\$parole')#passwd=PASSWORD)#" \
        "$p/lib/python3.14/urllib/request.py"

    find "$p/lib/python3.14" -type d -name '__pycache__' -exec rm -rf {} +

    # only the first line of real scripts (python3-config is sh): never sed a binary or follow a link
    for f in "$p"/bin/*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        [ "$(head -c2 "$f")" = "#!" ] || continue
        sed -i -e '1s#^\#! */bin/sh#\#!/overlayer/syshub/bin/sh#' \
            -e '1s#^\#! */usr/bin/env #\#!/overlayer/syshub/bin/env #' "$f"
    done

    mkdir -p "$STAGING_ROOT/_python-dev"
    mv "$p/include" "$STAGING_ROOT/_python-dev/include"
    mv "$p/lib/pkgconfig" "$STAGING_ROOT/_python-dev/pkgconfig"
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$STAGING_ROOT/_python-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_python-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
}
