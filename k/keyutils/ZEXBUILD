maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=keyutils
pkgver=1.6.3
pkgrel=0
source="https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git/snapshot/keyutils-$pkgver.tar.gz"
sha256sums="a61d5706136ae4c05bd48f86186bcfdbd88dd8bd5107e3e195c924cfc1b39bb4  keyutils-$pkgver.tar.gz"

build() {
    # its Makefile picks LIBDIR from ldd and takes the rest as make variables
    set -- NO_ARLIB=1 LIBDIR=/overlayer/syshub/lib USRLIBDIR=/overlayer/syshub/lib \
        BINDIR=/overlayer/syshub/bin SBINDIR=/overlayer/syshub/bin ETCDIR=/overlayer/syshub/etc \
        SHAREDIR=/overlayer/syshub/share/keyutils MANDIR=/overlayer/syshub/share/man \
        INCLUDEDIR=/overlayer/syshub/include
    make "$@"
    make "$@" DESTDIR="$(pwd)/_zexbuild-install" install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    cp -a "$inst"/. "$PAYLOAD_DIR/"
    # runtime only: headers, pkgconfig, static archives and docs stay out of the base
    rm -rf "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/share/man" \
        "$PAYLOAD_DIR/share/doc" "$PAYLOAD_DIR/share/gtk-doc" "$PAYLOAD_DIR/share/info"
    find "$PAYLOAD_DIR" \( -name '*.a' -o -name '*.la' \) -delete
}
