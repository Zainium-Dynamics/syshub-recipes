maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=spirv-tools
pkgver=2026.3
pkgrel=0
subpackages="spirv-tools-dev"
_headers_commit=29981f65241605e08b0ede4cfeb999fe3b723c6a
source="https://github.com/KhronosGroup/SPIRV-Tools/archive/refs/tags/v$pkgver.tar.gz
https://github.com/KhronosGroup/SPIRV-Headers/archive/$_headers_commit.tar.gz"
sha256sums="fff0667b25dfb98177da3cc4cc61ac277d076786df42baaf8d9635a25bdf9226  v$pkgver.tar.gz
232899f1ad4104fb5bc377b94596c7621575eee62ad9a9e8f929b63a7dd8a7ad  $_headers_commit.tar.gz"
makedepends="cmake ninja python3"

build() {
    cd "SPIRV-Tools-$pkgver"
    export LDFLAGS="-Wl,-dynamic-linker=/overlayer/syshub/x86_64-zainium-linux-musl/lib/ld-musl-x86_64.so.1 -Wl,-rpath=/overlayer/syshub/lib"
    cmake -B builddir -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DSPIRV_SKIP_TESTS=ON \
        -DSPIRV_WERROR=OFF \
        -DSPIRV-Headers_SOURCE_DIR="$(pwd)/../SPIRV-Headers-$_headers_commit"
    cmake --build builddir
}

package() {
    DESTDIR="$PAYLOAD_DIR" cmake --install builddir

    mkdir -p "$STAGING_ROOT/_spirv-tools-dev"
    mv "$PAYLOAD_DIR/overlayer/syshub/include" "$STAGING_ROOT/_spirv-tools-dev/include"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/pkgconfig" "$STAGING_ROOT/_spirv-tools-dev/pkgconfig"
    mv "$PAYLOAD_DIR/overlayer/syshub/lib/cmake" "$STAGING_ROOT/_spirv-tools-dev/cmake"

    strip "$PAYLOAD_DIR/overlayer/syshub/lib/"*.so* "$PAYLOAD_DIR/overlayer/syshub/bin/"* 2>/dev/null || true
}

dev() {
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/lib/cmake"
    cp -a "$STAGING_ROOT/_spirv-tools-dev/include/." "$PAYLOAD_DIR/include/"
    cp -a "$STAGING_ROOT/_spirv-tools-dev/pkgconfig/." "$PAYLOAD_DIR/lib/pkgconfig/"
    cp -a "$STAGING_ROOT/_spirv-tools-dev/cmake/." "$PAYLOAD_DIR/lib/cmake/"
}
