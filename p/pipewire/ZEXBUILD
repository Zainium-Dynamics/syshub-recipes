maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=pipewire
pkgver=1.6.11
pkgrel=0
subpackages="pipewire-dev"
source="https://github.com/PipeWire/pipewire/archive/refs/tags/$pkgver.tar.gz"
sha256sums="f3f70c4af173cc93d05070a9d412efe3ef5889bdf4ac32298e2c0d9ae1350559  $pkgver.tar.gz"
# gettext-dev, not bare musl-libintl -- installing musl-libintl
# directly conflicts with gettext-dev (which other recipes in the same
# CI container pull in transitively via glib-dev): "breaks:
# gettext-dev[!musl-libintl]". gettext-dev depends on musl-libintl
# itself, so this still gets libintl.h without the conflict.
makedepends="alsa-lib-dev eudev-dev gettext-dev vulkan-headers vulkan-loader-dev sbc-dev bluez-dev glib-dev python3"
needs_toolchain="systemd systemd-dev dbus dbus-dev readline readline-dev ncurses ncurses-dev mesa mesa-dev libdrm libdrm-dev"

# Bluetooth audio (bluez5 plugin) with SBC; the other codecs need
# libraries the base doesn't have yet.
# Minimal first pass: core pipewire daemon + client library + ALSA
# backend + udev device detection only. session-managers=[] -- the
# wireplumber recipe (next) is the real session manager, not the
# deprecated built-in media-session. Everything else (video/v4l2, jack compat, pulseaudio compat, gstreamer, ffmpeg,
# systemd, dbus, x11, vulkan, codecs...) disabled -- optional, no
# recipes published for their own deps yet, follow-up work.
build() {
    mkdir -p "$(pwd)/_pc"
    cat > "$(pwd)/_pc/systemd.pc" <<'EOF'
prefix=/overlayer/syshub
systemduserunitdir=${prefix}/lib/systemd/user
systemdsystemunitdir=${prefix}/lib/systemd/system

Name: systemd
Description: systemd
Version: 261
EOF
    # the base's gio-2.0.pc names /overlayer/syshub/bin/gdbus-codegen, which is
    # not in the build container; the bluez5 plugin generates its D-Bus code
    # with the container's own
    export PKG_CONFIG_GIO_2_0_GDBUS_CODEGEN=/usr/bin/gdbus-codegen
    export PKG_CONFIG_PATH="$(pwd)/_pc:/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        --localstatedir=/overlayer/syshub/var \
        -Ddocs=disabled \
        -Dman=disabled \
        -Dexamples=disabled \
        -Dtests=disabled \
        -Dinstalled_tests=disabled \
        -Dsession-managers=[] \
        -Dsystemd-user-service=enabled \
        -Dsystemd-system-service=enabled \
        -Dsystemd-system-unit-dir=/overlayer/syshub/lib/systemd/system \
        -Dsystemd-user-unit-dir=/overlayer/syshub/lib/systemd/user \
        -Dalsa=enabled \
        -Dpipewire-alsa=enabled \
        -Dudev=enabled \
        -Dcontrol=enabled \
        -Daudiomixer=enabled \
        -Daudioconvert=enabled \
        -Dsupport=enabled \
        -Dlibsystemd=enabled \
        -Dlogind=enabled \
        -Dselinux=disabled \
        -Dpipewire-jack=disabled \
        -Djack=disabled \
        -Dpipewire-v4l2=disabled \
        -Dv4l2=disabled \
        -Dbluez5=enabled \
        -Dbluez5-backend-hsp-native=enabled \
        -Dbluez5-backend-hfp-native=enabled \
        -Dbluez5-backend-native-mm=disabled \
        -Dbluez5-codec-g722=enabled \
        -Dbluez5-codec-aptx=disabled \
        -Dbluez5-codec-ldac=disabled \
        -Dbluez5-codec-ldac-dec=disabled \
        -Dbluez5-codec-aac=disabled \
        -Dbluez5-codec-lc3plus=disabled \
        -Dbluez5-codec-opus=disabled \
        -Dbluez5-codec-lc3=disabled \
        -Dbluez5-plc-spandsp=disabled \
        -Dffmpeg=disabled \
        -Ddbus=enabled \
        -Dsdl2=disabled \
        -Dsndfile=disabled \
        -Dlibpulse=disabled \
        -Droc=disabled \
        -Davahi=disabled \
        -Decho-cancel-webrtc=disabled \
        -Dlibusb=disabled \
        -Draop=disabled \
        -Dlv2=disabled \
        -Dx11=disabled \
        -Dx11-xfixes=disabled \
        -Dlibcanberra=disabled \
        -Davb=disabled \
        -Dflatpak=disabled \
        -Dreadline=enabled \
        -Dgsettings=disabled \
        -Dopus=disabled \
        -Dlibffado=disabled \
        -Dfftw=disabled \
        -Donnxruntime=disabled \
        -Dvulkan=enabled \
        -Dgstreamer=disabled \
        -Dlibcamera=disabled
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    find "$inst/lib" -maxdepth 1 -name 'libpipewire*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/lib/pipewire-0.3" "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    cp -a "$inst/lib/spa-0.2" "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/"
    cp -a "$inst/share/pipewire" "$PAYLOAD_DIR/share/" 2>/dev/null || true
    # bluez5 device quirks (share/spa-0.2/bluez5/bluez-hardware.conf)
    cp -a "$inst/share/spa-0.2" "$PAYLOAD_DIR/share/" 2>/dev/null || true
    cp -a "$inst"/share/alsa* "$PAYLOAD_DIR/share/" 2>/dev/null || true
    cp -a "$inst/lib/systemd" "$PAYLOAD_DIR/lib/"
    cp -a "$inst/lib/udev" "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    mkdir -p "$PAYLOAD_DIR/lib/systemd/user/sockets.target.wants"
    ln -sf ../pipewire.socket "$PAYLOAD_DIR/lib/systemd/user/sockets.target.wants/pipewire.socket"
    ln -sf ../pipewire-pulse.socket "$PAYLOAD_DIR/lib/systemd/user/sockets.target.wants/pipewire-pulse.socket"
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/"
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/"
}
