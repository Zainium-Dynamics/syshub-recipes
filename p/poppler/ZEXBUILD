maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=poppler
pkgver=24.09.0
pkgrel=0
subpackages="poppler-dev"
source="https://poppler.freedesktop.org/poppler-$pkgver.tar.xz"
sha256sums="ebd857987e2395608c69fdc44009692d5906f13b612c5280beff65a0b75dc255  poppler-$pkgver.tar.xz"
# cmake is Zainium's own (with the libraries it needs); ninja from Alpine.
needs_toolchain="cmake gcc-musl fontconfig fontconfig-dev freetype freetype-dev libjpeg-turbo libjpeg-turbo-dev libpng libpng-dev libtiff libtiff-dev zlib zlib-dev"
makedepends="samurai pkgconf"

# PDF rendering library. cups-filters' pdftoraster/pdftopdf link libpoppler and
# libpoppler-cpp, so we build the core + the cpp frontend only. No glib/qt GUI,
# no command-line utils, no nss/gpg/curl/lcms/openjpeg.
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    /overlayer/syshub/bin/cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_CPP=ON \
        -DENABLE_GLIB=OFF \
        -DENABLE_QT5=OFF \
        -DENABLE_QT6=OFF \
        -DENABLE_GOBJECT_INTROSPECTION=OFF \
        -DENABLE_UTILS=OFF \
        -DENABLE_BOOST=OFF \
        -DENABLE_NSS3=OFF \
        -DENABLE_GPGME=OFF \
        -DENABLE_LIBCURL=OFF \
        -DENABLE_LIBTIFF=ON \
        -DENABLE_DCTDECODER=libjpeg \
        -DENABLE_LIBOPENJPEG=none \
        -DCMAKE_DISABLE_FIND_PACKAGE_LCMS2=ON \
        -DBUILD_GTK_TESTS=OFF \
        -DBUILD_QT5_TESTS=OFF \
        -DBUILD_QT6_TESTS=OFF \
        -DBUILD_CPP_TESTS=OFF \
        -DBUILD_MANUAL_TESTS=OFF \
        -DRUN_GPERF_IF_PRESENT=OFF
    /overlayer/syshub/bin/cmake --build build -j"$(nproc)"
    DESTDIR="$(pwd)/_zexbuild-install" /overlayer/syshub/bin/cmake --install build
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 \( -name 'libpoppler.so*' -o -name 'libpoppler-cpp.so*' \) \
        -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    :
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/lib/cmake"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
    cp -a "$inst"/lib/cmake/. "$PAYLOAD_DIR/lib/cmake/" 2>/dev/null || true
}
