maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=qpdf
pkgver=11.9.1
pkgrel=0
subpackages="qpdf-dev"
source="https://github.com/qpdf/qpdf/releases/download/v$pkgver/qpdf-$pkgver.tar.gz"
sha256sums="2ba4d248f9567a27c146b9772ef5dc93bd9622317978455ffe91b259340d13d1  qpdf-$pkgver.tar.gz"
# cmake is Zainium's own (with the libraries it needs); ninja from Alpine.
needs_toolchain="cmake gcc-musl acl bzip2 curl expat libarchive lz4 nghttp2 openssl xz zlib zstd zlib-dev libjpeg-turbo libjpeg-turbo-dev"
makedepends="samurai pkgconf"

# PDF transformation library; cups-filters' pdftopdf links libqpdf. Native crypto
# only, so no gnutls/openssl detection; just the library, no CLI or docs.
build() {
    export PKG_CONFIG_PATH="/overlayer/syshub/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    # GCC 15 needs an explicit <cstdint>; force-include it into every TU so the
    # bundled libtests (built even with BUILD_TESTING=OFF) compile.
    /overlayer/syshub/bin/cmake -S . -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/overlayer/syshub \
        -DCMAKE_PREFIX_PATH=/overlayer/syshub \
        -DCMAKE_C_COMPILER=/overlayer/syshub/bin/gcc \
        -DCMAKE_CXX_COMPILER=/overlayer/syshub/bin/g++ \
        -DCMAKE_CXX_FLAGS="-include cstdint" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=OFF \
        -DUSE_IMPLICIT_CRYPTO=OFF \
        -DREQUIRE_CRYPTO_NATIVE=ON \
        -DBUILD_DOC=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_DOC_DIST=OFF
    /overlayer/syshub/bin/cmake --build build -j"$(nproc)"
    DESTDIR="$(pwd)/_zexbuild-install" /overlayer/syshub/bin/cmake --install build
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib"
    find "$inst/lib" -maxdepth 1 -name 'libqpdf.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
}

dev() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/include" "$PAYLOAD_DIR/lib/pkgconfig" "$PAYLOAD_DIR/lib/cmake"
    cp -a "$inst"/include/. "$PAYLOAD_DIR/include/" 2>/dev/null || true
    cp -a "$inst"/lib/pkgconfig/. "$PAYLOAD_DIR/lib/pkgconfig/" 2>/dev/null || true
    cp -a "$inst"/lib/cmake/. "$PAYLOAD_DIR/lib/cmake/" 2>/dev/null || true
}
