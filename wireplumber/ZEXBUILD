maintainer="Zainium Dynamics <alizain@zainiumdynamics.tech>"
pkgname=wireplumber
pkgver=0.5.15
pkgrel=3
source="https://gitlab.freedesktop.org/pipewire/wireplumber/-/archive/$pkgver/wireplumber-$pkgver.tar.gz"
sha256sums="baa121bc918df5fa0e0e70755bb1c99ffab0ab107225ecf99aa470e2c6ba5e7b  wireplumber-$pkgver.tar.gz"
makedepends="meson"
needs_toolchain="systemd systemd-dev glib glib-dev pcre2 pcre2-dev libffi libffi-dev zlib zlib-dev gettext gettext-dev pipewire pipewire-dev"

build() {
    mkdir -p "$(pwd)/_pc"
    cat > "$(pwd)/_pc/systemd.pc" <<'EOF'
prefix=/overlayer/syshub
systemduserunitdir=${prefix}/lib/systemd/user
systemdsystemunitdir=${prefix}/lib/systemd/system

Name: systemd
Description: systemd
Version: 261
EOF
    export CPPFLAGS="-I/overlayer/syshub/include ${CPPFLAGS:-}"
    export CFLAGS="-I/overlayer/syshub/include ${CFLAGS:-}"
    export LDFLAGS="-L/overlayer/syshub/lib ${LDFLAGS:-}"
    export PKG_CONFIG_PATH="$(pwd)/_pc:/overlayer/syshub/lib/pkgconfig:/overlayer/syshub/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    meson setup builddir \
        --prefix=/overlayer/syshub \
        --libdir=/overlayer/syshub/lib \
        --includedir=/overlayer/syshub/include \
        --sysconfdir=/overlayer/syshub/etc \
        -Ddoc=disabled \
        -Dtests=false \
        -Ddbus-tests=false \
        -Dsystemd=enabled \
        -Dsystemd-user-service=true \
        -Dsystemd-system-service=true \
        -Dsystemd-system-unit-dir=/overlayer/syshub/lib/systemd/system \
        -Dsystemd-user-unit-dir=/overlayer/syshub/lib/systemd/user \
        -Delogind=disabled \
        -Dintrospection=disabled
    ninja -C builddir
    DESTDIR="$(pwd)/_zexbuild-install" ninja -C builddir install
}

package() {
    local inst="_zexbuild-install/overlayer/syshub"
    mkdir -p "$PAYLOAD_DIR/lib" "$PAYLOAD_DIR/bin" "$PAYLOAD_DIR/share"
    find "$inst/lib" -maxdepth 1 -name 'libwireplumber*.so*' -exec cp -P {} "$PAYLOAD_DIR/lib/" \;
    cp -a "$inst/lib/wireplumber-0.5" "$PAYLOAD_DIR/lib/" 2>/dev/null || true
    cp -a "$inst"/bin/. "$PAYLOAD_DIR/bin/"
    cp -a "$inst/share/wireplumber" "$PAYLOAD_DIR/share/" 2>/dev/null || true
    cp -a "$inst/lib/systemd" "$PAYLOAD_DIR/lib/"
    mkdir -p "$PAYLOAD_DIR/lib/systemd/user/pipewire.service.wants"
    ln -sf ../wireplumber.service "$PAYLOAD_DIR/lib/systemd/user/pipewire.service.wants/wireplumber.service"
    find "$PAYLOAD_DIR" -type f | while read -r f; do
        grep -q '/usr' "$f" || continue
        tr -d '\000' < "$f" | cmp -s - "$f" || continue
        sed -i -e 's#/usr/local#/overlayer/syshub#g' -e 's#/usr/#/overlayer/syshub/#g' "$f"
    done
}
