maintainer="Ali Zain <alizain@zainiumdynamics.tech>"
pkgname=eclipse-comp
pkgver=0.1.0
pkgrel=0
# Zainium's own permanent Wayland compositor fork of cosmic-comp. Pushed
# to a real, independent repo. No tags/releases exist yet on
# Zainium-Dynamics/eclipse-comp, so pinned to the current HEAD commit's
# real archive URL (matches the earlier commit-hash-pin convention used
# for the cosmic-* recipes before they had tags) -- no sha256sums yet
# since this repo is still moving and isn't tagged.
#
# No systemd anywhere (verified: no systemd/libsystemd crate, no
# systemd:: calls). It DOES use D-Bus (zbus) in src/dbus/ -- correcting
# an earlier wrong claim in this file that it had none:
#   - logind.rs: logind_zbus::manager::ManagerProxy for lid-switch
#     inhibit/state, same login1 D-Bus surface quantra-logind implements
#     via oxibus -- works the same way cosmic-session's login1 usage
#     does against this stack.
#   - power.rs: com.system76.PowerDaemon (System76's own proprietary
#     service, not freedesktop-standard) for GPU hot-plug detection --
#     Zainium doesn't ship this and never will; the connect failure is
#     caught and logged at info level, not fatal.
#   - mod.rs: both the system and session D-Bus connections themselves
#     are established with `if let Err(err) = ... { error!(...) }`
#     around every consumer, not unwrap/expect -- if no broker is
#     running at all (oxibus not started yet), the compositor still
#     starts; only lid-switch handling, GPU hot-plug, and the a11y
#     keyboard monitor degrade.
# No flatpak dependency anywhere in this crate.
source="https://github.com/Zainium-Dynamics/eclipse-comp/archive/66b58bd1ae3a8f9899aca7e7eb193b4fbe7721ae.tar.gz"
makedepends="wayland-dev wayland-protocols libxkbcommon-dev libinput-dev libseat-dev mesa-dev libdrm-dev pixman-dev fontconfig-dev freetype-dev eudev-dev libdisplay-info-dev"

build() {
    # GitHub commit-archive extracted-dir name != $pkgname.
    cd eclipse-comp-66b58bd1ae3a8f9899aca7e7eb193b4fbe7721ae

    cargo build --release --target x86_64-unknown-linux-musl
}

package() {
    install -Dm755 \
        target/x86_64-unknown-linux-musl/release/eclipse-comp \
        "$PAYLOAD_DIR"/bin/eclipse-comp
}
